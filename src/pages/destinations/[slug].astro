const extras = destinationExtras[destination.slug] || {
  idealDuration: "2 Days",
  nearestAirport: "Cochin International (COK)",
  nearestRailway: "Ernakulam Junction (ERS)",
  altitude: "Lowland",
  knownFor: ["Scenic Landscapes", "Kerala Culture", "Local Delicacies"],
  attractions: destination.highlights.map((h: string) => ({
    name: h,
    tag: "Highlight",
    description: `Experience the unique charm of ${h} in ${destination.name}.`,
    icon: "✦"
  })),
  experiences: [
    { title: "Local Sightseeing & Heritage", subtitle: "Cultural Discovery", description: `Explore the celebrated sights and history of ${destination.name}.`, icon: "📍" },
    { title: "Authentic Regional Cuisine", subtitle: "Culinary Highlights", description: "Taste authentic Kerala flavours prepared with local coconut, spices, and fresh produce.", icon: "🍲" }
  ],
  travelTips: [
    "Plan your visits early in the morning or late afternoon for pleasant temperatures.",
    "Local chauffeurs and guides provide the best insider perspectives on hidden gems."
  ]
};

// Filter related packages that touch this destination
const relatedPackages = packages.filter((pkg) => {
  const query = destination.name.toLowerCase();
  const slug = destination.slug.toLowerCase();
  return (
    pkg.places.toLowerCase().includes(query) ||
    pkg.places.toLowerCase().includes(slug) ||
    pkg.description.toLowerCase().includes(query) ||
    pkg.description.toLowerCase().includes(slug) ||
    (destination.category.includes("Backwaters") && pkg.places.toLowerCase().includes("alleppey")) ||
    (destination.category.includes("Hills") && pkg.places.toLowerCase().includes("munnar"))
  );
});

// Fallback to top packages if none strictly match
const displayPackages = relatedPackages.length > 0 ? relatedPackages.slice(0, 3) : packages.slice(0, 3);

// WhatsApp message builder
const whatsappNumber = "919876543210";
const whatsappText = encodeURIComponent(
  `Hi MakeMyKerala! I am interested in planning a holiday to ${destination.name}. Please share customized itineraries and hotel stay options.`
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;

// Structured Schema
const destinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": destination.name,
  "description": destination.shortDescription,
  "touristType": ["Couples", "Family", "Adventure", "Nature Lovers"],
  "image": `https://makemykerala.vercel.app${destination.image}`,
  "address": {
    "@type": "PostalAddress",
    "addressRegion": destination.region,
    "addressCountry": "IN"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://makemykerala.vercel.app/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Destinations",
      "item": "https://makemykerala.vercel.app/destinations/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": destination.name,
      "item": `https://makemykerala.vercel.app/destinations/${destination.slug}/`
    }
  ]
};
---

<Layout
  title={`${destination.name} Travel Guide | Tourist Places & Packages - Make My Kerala`}
  description={`Plan your trip to ${destination.name}, Kerala. Explore top attractions, best time to visit, signature experiences, and curated tour packages with Make My Kerala.`}
  image={destination.image}
  schema={[destinationSchema, breadcrumbSchema]}
>
  <Header />

  <main class="dest-detail-page">
    
    <!-- =====================================================
         1. FULL COVER CINEMATIC HERO SECTION
    ====================================================== -->
    <section class="dest-hero" aria-label={`${destination.name} Hero`}>
      <div class="dest-hero-bg" aria-hidden="true">
        <img
          src={destination.image}
          alt={`${destination.name}, ${destination.region}, Kerala`}
          class="dest-hero-image"
          width="1920"
          height="800"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="dest-hero-veil"></div>
      </div>

      <div class="container dest-hero-container">

        <!-- BADGES -->
        <div class="dest-hero-badges">
          <span class="dest-badge-primary">✦ {destination.category.toUpperCase()}</span>
          <span class="dest-badge-secondary">📍 {destination.region}</span>
        </div>

        <h1 class="dest-hero-title">
          Explore <span class="editorial-accent">{destination.name}</span>
        </h1>

        <p class="dest-hero-tagline">{destination.tagline}</p>

        <!-- TRAVEL QUICK FACTS BAR -->
        <div class="dest-facts-bar">
          <div class="dest-fact-item">
            <span class="fact-icon" aria-hidden="true">⏱️</span>
            <div>
              <span class="fact-label">Ideal Duration</span>
              <strong class="fact-value">{extras.idealDuration}</strong>
            </div>
          </div>

          <div class="fact-divider" aria-hidden="true"></div>

          <div class="dest-fact-item">
