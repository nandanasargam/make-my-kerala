---
// src/pages/destinations/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { destinations } from "../../data/destinations.js";
import { packages } from "../../data/packages.js";
import "../../styles/global.css";

export async function getStaticPaths() {
  return destinations.map((dest) => ({
    params: { slug: dest.slug },
    props: { destination: dest }
  }));
}

const { destination } = Astro.props;

// Rich destination-specific extended content
const destinationExtras: Record<string, {
  idealDuration: string;
  nearestAirport: string;
  nearestRailway: string;
  altitude?: string;
  knownFor: string[];
  attractions: Array<{ name: string; tag: string; description: string; icon: string }>;
  experiences: Array<{ title: string; subtitle: string; description: string; icon: string }>;
  travelTips: string[];
}> = {
  munnar: {
    idealDuration: "2 - 3 Days",
    nearestAirport: "Cochin International (COK) — 110 km (3.5 hrs drive)",
    nearestRailway: "Aluva (AWY) — 108 km / Ernakulam (ERS) — 120 km",
    altitude: "1,600m above sea level",
    knownFor: ["Undulating Tea Plantations", "Nilgiri Tahr", "Misty Mountain Peaks", "Neelakurinji Blooms"],
