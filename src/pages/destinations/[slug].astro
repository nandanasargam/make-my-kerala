    idealDuration: "2 - 3 Days",
    nearestAirport: "Calicut International (CCJ) — 85 km (2.5 hrs drive)",
    nearestRailway: "Kozhikode / Calicut (CLT) — 80 km",
    altitude: "700m - 2,100m above sea level",
    knownFor: ["Prehistoric Rock Caves", "Rainforest Waterfalls", "Banasura Earthen Dam", "Coffee & Tea Estates"],
    attractions: [
      { name: "Edakkal Caves", tag: "Neolithic Archaeology", description: "Two natural caves on Ambukuthi Mala featuring petroglyphs and human etchings dating back over 6,000 years.", icon: "🗿" },
