      { name: "Soochipara Waterfalls", tag: "Cascading Torrent", description: "Three-tiered falls crashing 200m down granite cliff faces, surrounded by deciduous and evergreen forests.", icon: "💦" },
      { name: "Chembra Peak & Heart Lake", tag: "High Altitude Trek", description: "Wayanad's highest summit (2,100m) renowned for its heart-shaped highland lake that never dries up.", icon: "❤️" },
      { name: "Muthanga Wildlife Sanctuary", tag: "Elephant Corridor", description: "Bordering Bandipur and Nagarhole reserves, home to spotted deer, leopards, tigers, and wild elephants.", icon: "🐅" },
      { name: "Pookode Freshwater Lake", tag: "Natural Basin", description: "Idyllic highland freshwater lake shaped like India's map, fringed by evergreen forests and blue lotus ponds.", icon: "🌸" }
    ],
    experiences: [
      { title: "Trek to Neolithic Edakkal Petroglyphs", subtitle: "Prehistoric Trail", description: "Hike through coffee estates and stone steps to decipher Stone Age carving motifs left by ancient humans.", icon: "⛏️" },
      { title: "Island Speedboating at Banasura Sagar", subtitle: "Mountain Waters", description: "Zoom across glistening reservoir channels threading between lush subtropical forest hillocks.", icon: "🚤" },
      { title: "Organic Coffee & Pepper Farm Stroll", subtitle: "Estate Living", description: "Walk through fragrant robusta coffee plantations shaded by jackfruit, silver oak, and wild pepper vines.", icon: "☕" }
    ],
    travelTips: [
      "Visiting Edakkal Caves requires a moderate uphill hike; carry water and wear non-slip walking shoes.",
