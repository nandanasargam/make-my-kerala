---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EnquiryForm from "../components/EnquiryForm.jsx";
import "../styles/global.css";
---

<Layout
  title="Contact Us | Make My Kerala - Plan Your South India Holiday"
  description="Get in touch with Make My Kerala's local travel specialists in Kochi. Call +91 98765 43210 or send an enquiry for a personalized Kerala tour itinerary."
>
  <Header />

  <main class="contact-page">
    <!-- HERO BANNER -->
    <section class="contact-hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Contact Us</span>
        </nav>
        <span class="hero-eyebrow">CONNECT WITH US</span>
        <h1>Let's Plan Your Dream Kerala Journey</h1>
        <p class="hero-desc">
          Speak with our local travel specialists based in Kochi. With 25 years of experience,
          we craft tailor-made holidays that match your pace, style, and budget.
        </p>
      </div>
    </section>

    <!-- MAIN CONTACT CONTENT -->
    <section class="contact-main-section">
      <div class="container contact-grid">
        
        <!-- LEFT: CONTACT INFO & TRUST -->
        <div class="contact-info-col">
          <div class="info-card">
            <span class="badge-eyebrow">GET IN TOUCH</span>
            <h2>Direct Local Assistance</h2>
            <p class="info-lead">
              Have questions about destinations, houseboats, or travel dates? Reach out via call, WhatsApp, or email. We typically reply within <strong>2 to 4 business hours</strong>.
            </p>

            <div class="contact-methods">
              <!-- CALL -->
              <div class="method-item">
                <div class="method-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="method-body">
                  <small>Call Our Travel Desk</small>
                  <strong><a href="tel:+919876543210">+91 98765 43210</a></strong>
                  <span>Mon – Sat: 9:00 AM – 8:00 PM IST</span>
                </div>
              </div>

              <!-- WHATSAPP -->
              <div class="method-item">
                <div class="method-icon wa-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.82 14.07c-.24.68-1.2 1.26-1.66 1.34-.44.07-1.01.1-3.23-.82-2.31-.96-3.8-3.3-3.91-3.46-.11-.15-.95-1.27-.95-2.42 0-1.15.6-1.72.82-1.95.22-.24.47-.3.63-.3.16 0 .32 0 .46.01.15.01.35-.06.55.42.2.49.68 1.66.74 1.78.06.12.1.27.02.43-.08.16-.12.26-.24.4-.12.14-.26.31-.37.42-.12.12-.24.25-.1.5.14.25.63 1.04 1.35 1.68.93.83 1.71 1.09 1.96 1.21.25.12.39.1.53-.06.15-.17.63-.73.8-1 .17-.26.34-.22.58-.13.24.08 1.51.71 1.77.84.26.13.43.19.49.3.06.11.06.66-.18 1.34z"/>
                  </svg>
                </div>
                <div class="method-body">
                  <small>Instant WhatsApp Chat</small>
                  <strong><a href="https://wa.me/919876543210?text=Hello%20MakeMyKerala%2C%20I%20would%20like%20to%20plan%20a%20trip%20to%20Kerala" target="_blank" rel="noopener noreferrer">+91 98765 43210</a></strong>
                  <span>Fastest responses for itinerary customization</span>
                </div>
              </div>

              <!-- EMAIL -->
              <div class="method-item">
                <div class="method-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div class="method-body">
                  <small>Email Inquiries</small>
                  <strong><a href="mailto:hello@makemykerala.com">hello@makemykerala.com</a></strong>
                  <span>Detailed quotes with day-by-day itineraries</span>
                </div>
              </div>

              <!-- OFFICE ADDRESS -->
              <div class="method-item">
                <div class="method-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="method-body">
                  <small>Operating Office</small>
                  <strong>MakeMyKerala Travel Desk</strong>
                  <span>MG Road / Marine Drive, Kochi, Kerala 682011, India</span>
                </div>
              </div>
            </div>

            <!-- RESPONSE PROMISE BADGE -->
            <div class="response-promise-box">
              <span class="promise-icon">⚡</span>
              <div>
                <strong>Our Quick Response Guarantee</strong>
                <p>Submit your enquiry and receive an initial itinerary overview and transparent quote within 2–4 hours during office hours.</p>
              </div>
            </div>

            <!-- TRUST PILLARS -->
            <div class="trust-highlights">
              <div class="trust-tag">✓ 25+ Years Experience</div>
              <div class="trust-tag">✓ Zero Hidden Charges</div>
              <div class="trust-tag">✓ 24/7 On-Tour Support</div>
              <div class="trust-tag">✓ Verified Stays &amp; Drivers</div>
            </div>
          </div>
        </div>

        <!-- RIGHT: INTERACTIVE FORM -->
        <div class="contact-form-col">
          <div class="form-wrapper">
            <div class="form-header">
              <span class="form-eyebrow">ONLINE ENQUIRY</span>
              <h3>Send Us Your Trip Details</h3>
              <p>Tell us what kind of Kerala experience you're looking for, and we'll design a customized quote for you.</p>
            </div>
            <EnquiryForm client:load />
          </div>
        </div>

      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="contact-faq-section">
      <div class="container">
        <div class="faq-header">
          <span class="badge-eyebrow">COMMON QUESTIONS</span>
          <h2>Frequently Asked Questions</h2>
          <p>Everything you need to know about planning and booking your Kerala holiday with us.</p>
        </div>

        <div class="faq-grid">
          <div class="faq-card">
            <h4>Can I customize the packages shown on the website?</h4>
            <p>Yes, absolutely! Every package on MakeMyKerala can be customized. You can adjust the number of days, swap destinations, upgrade hotels, or include special experiences like treehouse stays, Kathakali shows, or Ayurvedic treatments.</p>
          </div>

          <div class="faq-card">
            <h4>How does airport pickup and local transportation work?</h4>
            <p>All our packages include a dedicated private air-conditioned vehicle (Sedan, Innova, or Tempo Traveller) with an experienced, verified chauffeur. The same vehicle and driver stay with you throughout your journey from arrival to airport departure.</p>
          </div>

          <div class="faq-card">
            <h4>What is the booking and payment process?</h4>
            <p>Once you approve the customized itinerary and quote, a nominal advance secures your hotel reservations, houseboat, and dedicated cab. The remaining balance can be settled upon arrival in Kerala or before trip commencement.</p>
          </div>

          <div class="faq-card">
            <h4>What happens if we need help during our trip?</h4>
            <p>You have a dedicated trip coordinator available 24/7 via phone and WhatsApp, in addition to your local driver. Any assistance, flight rescheduling, or hotel coordination is handled immediately.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    background-color: #f7f5ed;
    min-height: 100vh;
  }

  /* HERO BANNER */
  .contact-hero {
    position: relative;
    padding: 70px 0 60px;
    background: linear-gradient(135deg, #092e22 0%, #12382a 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .contact-hero .hero-bg {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image: radial-gradient(circle at 20% 50%, #c98b36 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 840px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 18px;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #f1c47b;
  }

  .breadcrumb .sep {
    opacity: 0.4;
  }

  .breadcrumb .current {
    color: #f1c47b;
    font-weight: 600;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    color: #f1c47b;
    margin-bottom: 12px;
  }

  .contact-hero h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(34px, 4.5vw, 54px);
    line-height: 1.15;
    margin: 0 0 16px;
    color: #ffffff;
    font-weight: 700;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  /* MAIN CONTENT GRID */
  .contact-main-section {
    padding: 70px 0 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: start;
  }

  /* LEFT INFO CARD */
  .info-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 42px 38px;
    box-shadow: 0 12px 35px rgba(18, 56, 42, 0.06);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .badge-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #c98b36;
    margin-bottom: 8px;
  }

  .info-card h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 32px;
    color: #12382a;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .info-lead {
    color: #556b60;
    font-size: 14px;
    line-height: 1.65;
    margin: 0 0 28px;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 28px;
  }

  .method-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .method-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #eef5f1;
    color: #12382a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-icon.wa-icon {
    background: #e6f9ed;
    color: #25d366;
  }

  .method-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .method-body small {
    font-size: 11px;
    font-weight: 700;
    color: #8c9891;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .method-body strong {
    font-size: 16px;
    color: #12382a;
  }

  .method-body strong a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .method-body strong a:hover {
    color: #c98b36;
  }

  .method-body span {
    font-size: 12px;
    color: #6a7c73;
  }

  /* RESPONSE PROMISE BOX */
  .response-promise-box {
    display: flex;
    gap: 14px;
    padding: 16px 18px;
    background: #fcf6ec;
    border-left: 4px solid #c98b36;
    border-radius: 8px;
    margin-bottom: 24px;
  }

  .promise-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .response-promise-box strong {
    display: block;
    font-size: 13px;
    color: #7d4f0d;
    margin-bottom: 4px;
  }

  .response-promise-box p {
    font-size: 12px;
    color: #6a5336;
    margin: 0;
    line-height: 1.5;
  }

  /* TRUST TAGS */
  .trust-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .trust-tag {
    font-size: 12px;
    font-weight: 600;
    color: #12382a;
    background: #f1f7f4;
    padding: 8px 12px;
    border-radius: 6px;
  }

  /* RIGHT FORM WRAPPER */
  .form-wrapper {
    background: #ffffff;
    border-radius: 18px;
    padding: 42px 38px;
    box-shadow: 0 12px 35px rgba(18, 56, 42, 0.06);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .form-header {
    margin-bottom: 24px;
  }

  .form-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #c98b36;
    margin-bottom: 6px;
  }

  .form-header h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 28px;
    color: #12382a;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .form-header p {
    font-size: 13px;
    color: #556b60;
    margin: 0;
    line-height: 1.5;
  }

  /* FAQ SECTION */
  .contact-faq-section {
    padding: 60px 0 90px;
    border-top: 1px solid rgba(18, 56, 42, 0.08);
  }

  .faq-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 45px;
  }

  .faq-header h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 36px;
    color: #12382a;
    margin: 8px 0 12px;
  }

  .faq-header p {
    font-size: 14px;
    color: #556b60;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .faq-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 28px 24px;
    box-shadow: 0 6px 20px rgba(18, 56, 42, 0.04);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .faq-card h4 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 20px;
    color: #12382a;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .faq-card p {
    font-size: 13px;
    line-height: 1.65;
    color: #556b60;
    margin: 0;
  }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .contact-hero {
      padding: 50px 0 45px;
    }

    .info-card,
    .form-wrapper {
      padding: 28px 20px;
    }

    .trust-highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
