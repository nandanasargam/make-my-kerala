---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// 13-SECTION CINEMATIC JOURNEY
import Hero from "../components/Hero.astro";
import KeralaIntro from "../components/KeralaIntro.astro";
import AboutStory from "../components/AboutStory.astro";
import FeaturedPackages from "../components/FeaturedPackages.astro";
import DestinationExplorer from "../components/DestinationExplorer.astro";
import ExperienceShowcase from "../components/ExperienceShowcase.astro";
import StaysSection from "../components/StaysSection.astro";
import WhyUs from "../components/WhyUs.astro";
import TravellerStories from "../components/TravellerStories.astro";
import FaqSection from "../components/FaqSection.astro";
import PlanJourneyCta from "../components/PlanJourneyCta.astro";
import PlanningCta from "../components/PlanningCta.astro";

import "../styles/global.css";
---

<Layout
  title="Make My Kerala | Curated Kerala Tours & Luxury Holiday Experiences"
  description="Experience God's Own Country with Make My Kerala. 25 years of personalized journeys across Munnar, Alleppey, Thekkady, Wayanad, and Kovalam. Handcrafted itineraries with local expertise."
>
  <Header />

  <main id="main-content">
    <!-- 01 — IMMERSIVE HERO -->
    <Hero />

    <!-- 02 — KERALA INTRO / OPENING STATEMENT -->
    <KeralaIntro />

    <!-- 03 — BRAND STORY & 25 YEARS HERITAGE -->
    <AboutStory />

    <!-- 04 — FEATURED JOURNEYS / PACKAGES -->
    <FeaturedPackages />

    <!-- 05 — DESTINATIONS: PLACES THAT BELONG ON YOUR ITINERARY -->
    <DestinationExplorer />

    <!-- 06 — SIGNATURE EXPERIENCES -->
    <ExperienceShowcase />

    <!-- 07 — HANDPICKED STAYS & RESORTS -->
    <StaysSection />

    <!-- 08 — WHY MAKE MY KERALA -->
    <WhyUs />

    <!-- 09 — TRAVELLER STORIES -->
    <TravellerStories />

    <!-- 10 — FAQ ACCORDION -->
    <FaqSection />

    <!-- 11 — PLAN YOUR JOURNEY CTA BANNER -->
    <PlanJourneyCta />

    <!-- 12 — BESPOKE TRIP ENQUIRY FORM -->
    <PlanningCta />
  </main>

  <!-- 13 — PREMIUM FOOTER -->
  <Footer />
</Layout>
