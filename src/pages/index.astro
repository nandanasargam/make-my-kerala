<!-- =========================================
     TESTIMONIALS
========================================= -->

<section class="testimonials-section">

  <div class="testimonials-overlay"></div>

  <div class="testimonials-container">

    <!-- SECTION HEADER -->
    <div class="testimonial-header">

      <div class="testimonial-label">
        <span class="label-line"></span>
        <span>TRAVELLER STORIES</span>
        <span class="label-line"></span>
      </div>

      <h2>
        Stories from the road
      </h2>

      <p>
        Real experiences from travellers who explored Kerala
        with us.
      </p>

    </div>


    <!-- TESTIMONIAL CARDS -->
    <div class="testimonial-slider-wrap">

      <button
  class="testimonial-arrow testimonial-arrow-left"
  type="button"
  aria-label="Previous testimonial"
></button>

      <div class="testimonial-grid">

        {testimonials.map((testimonial, index) => (

          <article
            class={`testimonial-card testimonial-card-${index + 1}`}
          >

            <!-- CARD IMAGE / TRAVEL AREA -->
            <div class="testimonial-card-top">

              <!-- QUOTE -->
              <div class="quote-mark">
                
              </div>


              <!-- RATING -->
              <div class="testimonial-rating">

               <span class="rating-star">
                  &#9733;
                </span>

                <span>
                  5.0
                </span>

                <span class="rating-text">
                  Traveller Review
                </span>

              </div>


              <!-- REVIEW -->
              <p class="testimonial-text">
                {testimonial.text}
              </p>


              <!-- TRAVEL ROUTE -->
              <div class="testimonial-route">

                <span class="route-start"></span>

                <span class="route-dashed"></span>

                <span class="route-pin">
                  &#9670;
                </span>

              </div>

            </div>


            <!-- TRAVELLER DETAILS -->
            <div class="testimonial-person">

              <div class="avatar">
                {testimonial.name.charAt(0)}
              </div>

              <div class="person-details">

                <strong>
                  {testimonial.name}
                </strong>

                <span>
                  {testimonial.location}
                </span>

              </div>

            </div>

          </article>

        ))}

      </div>


      <button
  class="testimonial-arrow testimonial-arrow-right"
  type="button"
  aria-label="Next testimonial"
></button>

    </div>


    <!-- SLIDER DOTS -->
    <div class="testimonial-dots">

      <span class="testimonial-dot active"></span>
      <span class="testimonial-dot"></span>
      <span class="testimonial-dot"></span>

    </div>


    <!-- BOTTOM MESSAGE -->
    <div class="testimonial-bottom">

      <span class="bottom-leaf">
        &#9671;
      </span>

      <p>
        Thank you to all our amazing travellers
        <br />
        for being a part of our journey.
      </p>

    </div>

  </div>

</section>

  <!-- FAQ -->

  <section class="faq-section">

    <div class="container faq-container">

      <div class="section-header">

        <span class="section-eyebrow">
          FREQUENTLY ASKED QUESTIONS
        </span>

        <h2>
          Planning your Kerala trip?
        </h2>

      </div>


      <div class="faq-list">

        {faqs.map((faq) => (

          <details>

            <summary>

              {faq.question}

              <span>+</span>

            </summary>

            <p>
              {faq.answer}
            </p>

          </details>

        ))}

      </div>

    </div>

  </section>


  <!-- CONTACT -->

  <section class="contact-section" id="contact">

    <div class="container contact-grid">

      <div class="contact-content">

        <span class="section-eyebrow">
          LET'S PLAN YOUR TRIP
        </span>

        <h2>
          Tell us about your dream Kerala holiday.
        </h2>

        <p>
          Share a few details about your trip and
          our travel team can help you plan an
          unforgettable journey through Kerala.
        </p>


        <div class="contact-details">

          <div class="contact-detail">

            <span class="contact-detail-icon">&#9742;</span>

            <div>

              <small>Call Us</small>

              <strong>
                +91 98765 43210
              </strong>

            </div>

          </div>


          <div class="contact-detail">

            <span class="contact-detail-icon">&#9993;</span>

            <div>

              <small>Email Us</small>

              <strong>
                hello@makemykerala.com
              </strong>

            </div>

          </div>


          <div class="contact-detail">

            <span class="contact-detail-icon">&#9906;</span>

            <div>

              <small>Based In</small>

              <strong>
                Kochi, Kerala, India
              </strong>

            </div>

          </div>

        </div>

      </div>


      <div class="form-container">

        <EnquiryForm client:load />

      </div>

    </div>

  </section>

</main>

