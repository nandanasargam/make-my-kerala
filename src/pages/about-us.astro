---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/about.css";
---

<Layout
  title="About Us | Make My Kerala - 25 Years of Travel Excellence in South India"
  description="Learn about MakeMyKerala, a trusted South India travel partner with 25 years of experience creating memorable journeys across Kerala, Tamil Nadu and beyond."
>

  <Header />

  <main class="about-page">

    <!-- =====================================================
         HERO SECTION
    ====================================================== -->

    <section class="about-hero">

      <div class="about-hero-pattern"></div>

      <div class="container about-hero-grid">

        <!-- LEFT CONTENT -->
        <div class="about-hero-content">

          <span class="about-hero-eyebrow">
            ABOUT MAKE MY KERALA
          </span>

          <h1>
            Journeys crafted
            <span>with experience.</span>
          </h1>

          <p>
            25 years of creating memorable journeys across
            Kerala and South India.
          </p>

          <div class="about-hero-actions">

            <a href="#our-story" class="about-primary-btn">
              Discover Our Story
            </a>

            <a href="#contact" class="about-secondary-btn">
              Plan Your Journey
            </a>

          </div>

        </div>


        <!-- RIGHT LOGO VISUAL -->
        <div class="about-hero-visual">

          <div class="hero-circle circle-one"></div>
          <div class="hero-circle circle-two"></div>

          <div class="hero-logo-card">

            <div class="hero-logo-glow"></div>

            <img
              src="/images/25yearslogo.webp"
              width="360"
              height="333"
              loading="eager"
              decoding="async"
              alt="MakeMyKerala 25 Years"
            />

          </div>

          <div class="hero-floating-card">

            <strong>25</strong>

            <span>
              YEARS OF
              <br />
              TRAVEL EXPERIENCE
            </span>

          </div>

        </div>

      </div>

      <div class="hero-bottom-wave">
        <span></span>
      </div>

    </section>


    <!-- =====================================================
         INTRODUCTION
    ====================================================== -->

    <section class="about-intro" id="our-story">

      <div class="container">

        <div class="about-section-heading">

          <span class="section-tag">
            OUR STORY
          </span>

          <h2>
            More than a holiday,
            <em>it's a memory.</em>
          </h2>

          <div class="heading-line">
            <span></span>
            <b>✦</b>
            <span></span>
          </div>

        </div>


        <div class="about-intro-grid">

          <div class="intro-number">

            <span>01</span>

            <div class="vertical-line"></div>

            <small>
              OUR
              <br />
              JOURNEY
            </small>

          </div>


          <div class="intro-text">

            <p class="large-text">
              Welcome to <strong>MakeMyKerala</strong>, your trusted travel
              partner with <strong>25 years of experience</strong> in creating
              memorable journeys across South India.
            </p>

            <p>
              With a strong presence in Kerala and Tamil Nadu, we specialize
              in curated holiday experiences that bring together comfort,
              culture, nature and authentic local hospitality.
            </p>

            <p>
              Over the years, we have proudly served thousands of travelers,
              families, groups and corporate guests, helping them discover
              the beauty and diversity of South India.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         25 YEARS SECTION
    ====================================================== -->

    <section class="twenty-five-section">

      <div class="twenty-five-background"></div>

      <div class="container twenty-five-grid">

        <div class="twenty-five-visual">

          <div class="year-orbit orbit-one"></div>
          <div class="year-orbit orbit-two"></div>

          <div class="year-number">
            <span>25</span>
            <small>YEARS</small>
          </div>

          <div class="year-leaf year-leaf-left">
            ❧
          </div>

          <div class="year-leaf year-leaf-right">
            ❧
          </div>

        </div>


        <div class="twenty-five-content">

          <span class="section-tag light">
            25 YEARS OF EXPERIENCE
          </span>

          <h2>
            Experience that
            <span>travels with you.</span>
          </h2>

          <p>
            For 25 years, MakeMyKerala has focused on creating journeys that
            are comfortable, carefully planned and meaningful.
          </p>

          <p>
            Our experience helps us understand that every traveler is
            different. A family holiday, honeymoon, pilgrimage, group trip
            or customized South India journey deserves a thoughtful approach.
          </p>

          <div class="experience-points">

            <div>
              <strong>25</strong>
              <span>Years of experience</span>
            </div>

            <div>
              <strong>South India</strong>
              <span>Travel expertise</span>
            </div>

            <div>
              <strong>Personal</strong>
              <span>Travel planning</span>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         WHAT WE DO
    ====================================================== -->

    <section class="what-we-do">

      <div class="container">

        <div class="about-section-heading centered">

          <span class="section-tag">
            WHAT WE DO
          </span>

          <h2>
            Travel designed
            <em>around you.</em>
          </h2>

          <p>
            Every journey begins with understanding what makes your trip
            special.
          </p>

        </div>


        <div class="service-cards">

          <article class="service-card">

            <div class="service-number">01</div>

            <div class="service-icon">
              ✦
            </div>

            <h3>
              Curated Holidays
            </h3>

            <p>
              Thoughtfully planned holidays combining sightseeing, relaxation,
              local experiences and value for money.
            </p>

          </article>


          <article class="service-card featured">

            <div class="service-number">02</div>

            <div class="service-icon">
              ◈
            </div>

            <h3>
              Personalized Journeys
            </h3>

            <p>
              Travel plans shaped around your interests, time, preferred
              experiences and style of travel.
            </p>

          </article>


          <article class="service-card">

            <div class="service-number">03</div>

            <div class="service-icon">
              ◇
            </div>

            <h3>
              South India Tours
            </h3>

            <p>
              Discover Kerala, Tamil Nadu and some of South India's most loved
              destinations through carefully organized tours.
            </p>

          </article>


          <article class="service-card">

            <div class="service-number">04</div>

            <div class="service-icon">
              ♢
            </div>

            <h3>
              Group & Corporate Travel
            </h3>

            <p>
              Seamless travel planning for groups and corporate guests with
              attention to comfort and coordination.
            </p>

          </article>


          <article class="service-card">

            <div class="service-number">05</div>

            <div class="service-icon">
              ❋
            </div>

            <h3>
              Family & Honeymoon Trips
            </h3>

            <p>
              From family vacations to romantic getaways, we help create
              journeys filled with memorable moments.
            </p>

          </article>


          <article class="service-card">

            <div class="service-number">06</div>

            <div class="service-icon">
              ✧
            </div>

            <h3>
              Customized Tours
            </h3>

            <p>
              Flexible South India holidays created to match your travel
              preferences and the experiences you want to discover.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         DESTINATIONS
    ====================================================== -->

    <section class="destinations-section" id="why-makemykerala">

      <div class="container">

        <div class="destination-heading">

          <div>

            <span class="section-tag">
              OUR SERVICE COMMITMENT
            </span>

            <h2>
              The Pillars of
              <span>MakeMyKerala.</span>
            </h2>

          </div>

          <p>
            With 25 years of local travel excellence, our promise to every guest
            is built on genuine hospitality, seamless planning, and unforgettable
            memories across God's Own Country.
          </p>

        </div>


        <div class="destination-list">

          <div class="destination-item">
            <span class="destination-index">01</span>
            <strong>25+ Years of Local Mastery</strong>
            <span class="destination-arrow">✓</span>
          </div>

          <div class="destination-item">
            <span class="destination-index">02</span>
            <strong>100% Customized Itineraries</strong>
            <span class="destination-arrow">✓</span>
          </div>

          <div class="destination-item">
            <span class="destination-index">03</span>
            <strong>Handpicked &amp; Inspected Stays</strong>
            <span class="destination-arrow">✓</span>
          </div>

          <div class="destination-item">
            <span class="destination-index">04</span>
            <strong>Dedicated Chauffeur Guides</strong>
            <span class="destination-arrow">✓</span>
          </div>

          <div class="destination-item">
            <span class="destination-index">05</span>
            <strong>Transparent, Direct Pricing</strong>
            <span class="destination-arrow">✓</span>
          </div>

          <div class="destination-item">
            <span class="destination-index">06</span>
            <strong>24/7 On-Tour Guest Support</strong>
            <span class="destination-arrow">✓</span>
          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         TRAVEL EXPERIENCES
    ====================================================== -->

    <section class="travel-experience">

      <div class="container travel-experience-grid">

        <div class="travel-experience-content">

          <span class="section-tag">
            EVERY JOURNEY IS DIFFERENT
          </span>

          <h2>
            From first
            <em>hello</em>
            to the final
            <em>memory.</em>
          </h2>

          <p>
            At MakeMyKerala, we believe that a good itinerary is more than
            a list of places. It should create the right rhythm between
            discovery and relaxation.
          </p>

          <p>
            From peaceful backwaters and misty hills to cultural experiences
            and local hospitality, our journeys are designed to help travelers
            experience South India in a comfortable and meaningful way.
          </p>

          <div class="journey-steps">

            <div class="journey-step">

              <span>01</span>

              <div>
                <h3>Understand</h3>
                <p>
                  We begin by understanding your travel needs and expectations.
                </p>
              </div>

            </div>


            <div class="journey-step">

              <span>02</span>

              <div>
                <h3>Plan</h3>
                <p>
                  Your itinerary is carefully structured around your journey.
                </p>
              </div>

            </div>


            <div class="journey-step">

              <span>03</span>

              <div>
                <h3>Experience</h3>
                <p>
                  Travel, explore, relax and create memories along the way.
                </p>
              </div>

            </div>

          </div>

        </div>


        <div class="travel-quote">

          <div class="quote-mark">
            “
          </div>

          <blockquote>
            Every journey should feel personal,
            purposeful and unforgettable.
          </blockquote>

          <div class="quote-line"></div>

          <span>
            THE MAKE MY KERALA APPROACH
          </span>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FOUNDERS
    ====================================================== -->

    <section class="founders-section">

      <div class="container founders-grid">

        <div class="founders-intro">

          <span class="section-tag">
            THE PEOPLE BEHIND THE JOURNEY
          </span>

          <h2>
            Built on
            <em>passion & trust.</em>
          </h2>

          <p>
            MakeMyKerala is jointly operated by
            <strong>Anitha Murali</strong> and
            <strong>Muraleedhara Shenoy</strong>.
          </p>

          <p>
            Their passion for travel and dedication to customer satisfaction
            have been the foundation of the company's success for over two
            decades.
          </p>

        </div>


        <div class="founder-card">

          <div class="founder-card-top">

            <span class="founder-symbol">
              ✦
            </span>

            <span>
              MAKE MY KERALA
            </span>

          </div>

          <div class="founder-names">

            <h3>
              Anitha Murali
            </h3>

            <span>&amp;</span>

            <h3>
              Muraleedhara Shenoy
            </h3>

          </div>

          <div class="founder-card-bottom">

            <span>
              25 YEARS
            </span>

            <span>
              TRAVEL • EXPERIENCE • HOSPITALITY
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         VALUES
    ====================================================== -->

    <section class="values-section">

      <div class="container">

        <div class="about-section-heading centered">

          <span class="section-tag">
            WHAT MATTERS TO US
          </span>

          <h2>
            The values behind
            <em>every journey.</em>
          </h2>

        </div>


        <div class="values-grid">

          <article class="value-item">

            <span>01</span>

            <h3>
              Personalized Service
            </h3>

            <p>
              Every traveler has a different idea of the perfect holiday.
              We keep that individuality at the heart of our planning.
            </p>

          </article>


          <article class="value-item">

            <span>02</span>

            <h3>
              Reliable Planning
            </h3>

            <p>
              We focus on thoughtful planning so your journey can be smooth,
              comfortable and enjoyable.
            </p>

          </article>


          <article class="value-item">

            <span>03</span>

            <h3>
              Genuine Hospitality
            </h3>

            <p>
              We value the warmth, culture and local character that make
              South India such a memorable place to explore.
            </p>

          </article>


          <article class="value-item">

            <span>04</span>

            <h3>
              Memorable Experiences
            </h3>

            <p>
              The goal is not simply to visit destinations, but to return
              home with experiences worth remembering.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         MISSION
    ====================================================== -->

    <section class="mission-section">

      <div class="mission-decoration mission-decoration-one"></div>
      <div class="mission-decoration mission-decoration-two"></div>

      <div class="container mission-inner">

        <span class="section-tag light">
          OUR MISSION
        </span>

        <h2>
          Creating lifelong
          <span>travel memories.</span>
        </h2>

        <p>
          Our mission is simple: to create lifelong travel memories through
          personalized service, reliable planning and genuine South Indian
          hospitality.
        </p>

        <div class="mission-divider">
          <span></span>
          <b>✦</b>
          <span></span>
          
        </div>

        <strong>
          Travel with MakeMyKerala.
        </strong>

        <small>
          Where every journey becomes a memory for life.
        </small>

      </div>

    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->

    <section class="about-cta" id="contact">

      <div class="container about-cta-inner">

        <div class="cta-content">

          <span class="section-tag">
            YOUR NEXT JOURNEY STARTS HERE
          </span>

          <h2>
            Ready to create
            <em>your Kerala story?</em>
          </h2>

          <p>
            Whether you are planning a honeymoon, family vacation,
            pilgrimage tour, group trip or a customized South India holiday,
            let us help shape your journey.
          </p>

        </div>

        <a href="/contact" class="about-cta-button">
          Begin Your Journey
          <span>→</span>
        </a>

      </div>

    </section>

  </main>

  <Footer />

</Layout>