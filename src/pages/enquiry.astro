---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EnquiryForm from "../components/EnquiryForm.jsx";
import "../styles/global.css";
---

<Layout
  title="Plan Your Kerala Holiday | Make an Enquiry — Make My Kerala"
  description="Send an enquiry or WhatsApp message to Make My Kerala's local travel specialists in Kochi. Customized tour itineraries, verified stays, and transparent package quotes."
>
  <Header />

  <main class="enquiry-page">
    <!-- HERO SECTION -->
    <section class="enquiry-hero" aria-label="Make an Enquiry Header">
      <div class="hero-bg" aria-hidden="true">
        <img
          src="/images/kerala2.webp"
          alt="Scenic Kerala backwaters and misty hills"
          width="1920"
          height="650"
          class="enquiry-hero-img"
          loading="eager"
          decoding="async"
        />
        <div class="hero-veil"></div>
      </div>
      <div class="container hero-inner">
        <span class="hero-eyebrow">CUSTOM HOLIDAY PLANNING</span>
        <h1>Plan Your Bespoke Kerala Holiday</h1>
        <p class="hero-desc">
          Tell us about your travel dates and group preferences. Our local travel specialists will design a transparent, customized itinerary and quote for your South India journey.
        </p>
      </div>
    </section>

    <!-- MAIN FORM & SIDEBAR SECTION -->
    <section class="enquiry-main-section">
      <div class="container enquiry-grid">
        
        <!-- MAIN FORM COLUMN -->
        <div class="enquiry-form-card">
          <div class="form-card-header">
            <span class="form-kicker">CENTRAL ENQUIRY DESK</span>
            <h2>Send Your Travel Details</h2>
            <p>
              Choose either <strong>Send Online Enquiry</strong> to email our desk, or <strong>Enquiry on WhatsApp</strong> to chat instantly with pre-filled details.
            </p>
          </div>

          <EnquiryForm client:load />
        </div>

        <!-- SIDEBAR INFO & TRUST PILLARS -->
        <aside class="enquiry-sidebar">
          
          <!-- DIRECT REACH CARD -->
          <div class="sidebar-card">
            <span class="sidebar-kicker">DIRECT ASSISTANCE</span>
            <h3>Prefer Direct Contact?</h3>
            <p class="sidebar-desc">
              Have quick questions or prefer speaking to an expert right away? Reach us directly via call or WhatsApp.
            </p>

            <div class="sidebar-contact-list">
              <!-- WHATSAPP -->
              <a
                href="https://wa.me/919745269272?text=Hello%20MakeMyKerala!%20I%20would%20like%20to%20plan%20a%20trip%20to%20Kerala."
                target="_blank"
                rel="noopener noreferrer"
                class="sidebar-contact-item wa-item"
              >
                <div class="contact-icon-box wa-bg" aria-hidden="true">
                  💬
                </div>
                <div class="contact-text-box">
                  <small>Official WhatsApp</small>
                  <strong>+91 97452 69272</strong>
                  <span>Instant replies for custom plans</span>
                </div>
              </a>

              <!-- PHONE -->
              <a href="tel:+919745269272" class="sidebar-contact-item">
                <div class="contact-icon-box" aria-hidden="true">
                  📞
                </div>
                <div class="contact-text-box">
                  <small>Call Travel Desk</small>
                  <strong>+91 97452 69272</strong>
                  <span>Mon – Sat: 9:00 AM – 8:00 PM IST</span>
                </div>
              </a>

              <!-- EMAIL -->
              <a href="mailto:makemykerala123@gmail.com" class="sidebar-contact-item">
                <div class="contact-icon-box" aria-hidden="true">
                  ✉️
                </div>
                <div class="contact-text-box">
                  <small>Official Email</small>
                  <strong>makemykerala123@gmail.com</strong>
                  <span>Detailed quotes &amp; itineraries</span>
                </div>
              </a>
            </div>

            <!-- RESPONSE GUARANTEE -->
            <div class="response-badge-box">
              <span class="response-icon" aria-hidden="true">⚡</span>
              <div>
                <strong>Fast Response Guarantee</strong>
                <p>We typically share your initial itinerary outline within 2–4 business hours.</p>
              </div>
            </div>
          </div>

          <!-- TRUST PILLARS CARD -->
          <div class="sidebar-card trust-card">
            <span class="sidebar-kicker">WHY MAKEMYKERALA</span>
            <h3>Trusted Local Mastery</h3>
            <ul class="trust-list">
              <li>
                <span class="check-mark" aria-hidden="true">✓</span>
                <div>
                  <strong>25+ Years Experience</strong>
                  <p>Over two decades of designing authentic Kerala &amp; South India tours.</p>
                </div>
              </li>
              <li>
                <span class="check-mark" aria-hidden="true">✓</span>
                <div>
                  <strong>100% Customized Trips</strong>
                  <p>Flexible dates, hotel upgrades, private vehicles, and personalized pace.</p>
                </div>
              </li>
              <li>
                <span class="check-mark" aria-hidden="true">✓</span>
                <div>
                  <strong>Transparent Direct Pricing</strong>
                  <p>Zero hidden docking fees, toll charges, or surprise extras.</p>
                </div>
              </li>
              <li>
                <span class="check-mark" aria-hidden="true">✓</span>
                <div>
                  <strong>24/7 On-Tour Support</strong>
                  <p>Dedicated holiday coordinator on standby throughout your travels.</p>
                </div>
              </li>
            </ul>
          </div>

        </aside>

      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="enquiry-faq-section">
      <div class="container">
        <div class="faq-header">
          <span class="faq-kicker">FREQUENTLY ASKED</span>
          <h2>How Booking Works with Make My Kerala</h2>
          <p>Everything you need to know about our enquiry and booking process.</p>
        </div>

        <div class="faq-grid">
          <div class="faq-card">
            <h4>1. What happens after I submit my enquiry?</h4>
            <p>Our destination specialists review your preferred dates, group size, and interests. We then craft a tailored itinerary draft with transparent pricing and hotel choices, sent to your email or WhatsApp within 2–4 hours.</p>
          </div>

          <div class="faq-card">
            <h4>2. Can I adjust or customize the itinerary?</h4>
            <p>Yes, completely! You can modify every aspect — add days, swap destinations, upgrade from Economy to Deluxe hotels, or add specific activities like houseboat day cruises, martial arts shows, or tea plantation walks.</p>
          </div>

          <div class="faq-card">
            <h4>3. How do payments and reservations work?</h4>
            <p>Once you are 100% satisfied with the itinerary and quote, a small token advance secures your vehicle, driver, and hotel bookings. The remaining amount is payable upon arrival in Kerala or before trip commencement.</p>
          </div>

          <div class="faq-card">
            <h4>4. Is a dedicated driver and vehicle included?</h4>
            <p>Yes. All our packages include a private, well-maintained air-conditioned car (Sedan, Innova Crysta, or Tempo Traveller) with a professional, verified chauffeur who stays with you throughout your journey.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .enquiry-page {
    background-color: #f7f5ed;
    min-height: 100vh;
  }

  /* HERO BANNER */
  .enquiry-hero {
    position: relative;
    width: 100%;
    min-height: clamp(340px, 38vh, 440px);
    display: flex;
    align-items: center;
    padding-block: clamp(60px, 7vw, 85px);
    color: #ffffff;
    overflow: hidden;
    background-color: #082017;
  }

  .enquiry-hero .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .enquiry-hero-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 35%;
  }

  .enquiry-hero .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 32, 23, 0.72) 0%,
      rgba(8, 32, 23, 0.88) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #f1c47b;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .enquiry-hero h1 {
    font-family: var(--font-serif, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(2.3rem, 4.5vw, 3.6rem);
    line-height: 1.15;
    margin: 0 0 14px;
    color: #ffffff;
    font-weight: 700;
    text-wrap: balance;
  }

  .hero-desc {
    font-size: clamp(0.98rem, 1.2vw, 1.1rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    max-width: 54ch;
    text-wrap: pretty;
  }

  /* MAIN ENQUIRY SECTION */
  .enquiry-main-section {
    padding: 65px 0 80px;
  }

  .enquiry-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: start;
  }

  /* FORM CARD */
  .enquiry-form-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 42px 38px;
    box-shadow: 0 12px 35px rgba(18, 56, 42, 0.06);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .form-card-header {
    margin-bottom: 26px;
    border-bottom: 1px solid #eef2ef;
    padding-bottom: 18px;
  }

  .form-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #c98b36;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .form-card-header h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 32px;
    color: #12382a;
    margin: 0 0 8px;
    line-height: 1.2;
    font-weight: 700;
  }

  .form-card-header p {
    font-size: 13.5px;
    color: #556b60;
    margin: 0;
    line-height: 1.5;
  }

  /* SIDEBAR */
  .enquiry-sidebar {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .sidebar-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 34px 28px;
    box-shadow: 0 10px 30px rgba(18, 56, 42, 0.05);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .sidebar-kicker {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.8px;
    color: #c98b36;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .sidebar-card h3 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 26px;
    color: #12382a;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .sidebar-desc {
    font-size: 13.5px;
    color: #556b60;
    line-height: 1.6;
    margin: 0 0 22px;
  }

  .sidebar-contact-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 22px;
  }

  .sidebar-contact-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #fbfbf8;
    border: 1px solid #e9e5dc;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sidebar-contact-item:hover {
    background: #f4efe4;
    border-color: #dbcbb3;
    transform: translateX(3px);
  }

  .sidebar-contact-item.wa-item {
    background: #f2fbf5;
    border-color: #c7eed5;
  }

  .sidebar-contact-item.wa-item:hover {
    background: #e6f7ec;
    border-color: #aae4bf;
  }

  .contact-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #eef5f1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .contact-icon-box.wa-bg {
    background: #e7f9ee;
  }

  .contact-text-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .contact-text-box small {
    font-size: 10.5px;
    font-weight: 700;
    color: #7d8e85;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .contact-text-box strong {
    font-size: 15px;
    color: #12382a;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .contact-text-box span {
    font-size: 11.5px;
    color: #6a7c73;
  }

  .response-badge-box {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    background: #fcf6ec;
    border-left: 3.5px solid #c98b36;
    border-radius: 8px;
  }

  .response-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .response-badge-box strong {
    display: block;
    font-size: 13px;
    color: #7d4f0d;
    margin-bottom: 2px;
  }

  .response-badge-box p {
    font-size: 12px;
    color: #6a5336;
    margin: 0;
    line-height: 1.45;
  }

  /* TRUST LIST */
  .trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .trust-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .check-mark {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #e7f7ed;
    color: #1b633e;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trust-list strong {
    display: block;
    font-size: 14px;
    color: #12382a;
    margin-bottom: 2px;
  }

  .trust-list p {
    font-size: 12.5px;
    color: #5d6e64;
    margin: 0;
    line-height: 1.45;
  }

  /* FAQ SECTION */
  .enquiry-faq-section {
    padding: 60px 0 90px;
    border-top: 1px solid rgba(18, 56, 42, 0.08);
  }

  .faq-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
  }

  .faq-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #c98b36;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .faq-header h2 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 34px;
    color: #12382a;
    margin: 6px 0 10px;
  }

  .faq-header p {
    font-size: 14px;
    color: #556b60;
    margin: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .faq-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 26px 22px;
    box-shadow: 0 4px 18px rgba(18, 56, 42, 0.04);
    border: 1px solid rgba(18, 56, 42, 0.08);
  }

  .faq-card h4 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 19px;
    color: #12382a;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .faq-card p {
    font-size: 13px;
    line-height: 1.6;
    color: #556b60;
    margin: 0;
  }

  /* RESPONSIVE BREAKPOINTS */
  @media (max-width: 992px) {
    .enquiry-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .enquiry-hero {
      min-height: 330px;
      padding-block: 50px;
    }

    .enquiry-hero h1 {
      font-size: clamp(2rem, 7vw, 2.5rem);
    }

    .enquiry-form-card,
    .sidebar-card {
      padding: 26px 18px;
      border-radius: 16px;
    }
  }
</style>
