---
// src/pages/hotels/kozhikode/index.astro
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import HotelCard from "../../../components/hotels/HotelCard.astro";
import { kozhikodeHotels } from "../../../data/hotels.js";
import "../../../styles/global.css";

const pageTitle = "Kozhikode Hotels & Resorts | 10 Handpicked Stays in Kozhikode - Make My Kerala";
const pageDescription = "Explore 10 curated hotels and resorts in Kozhikode, Kerala. The legendary City of Spices and historic port of Vasco da Gama, renowned for unmatched Malabar culinary traditions, bustling bazaars, and sunset beaches. Verified properties curated by MakeMyKerala.";

const categories = [
  "All Stays",
  "City Center & Business",
  "Beachfront & Kappad",
  "4-Star Luxury",
  "Malabar Culinary"
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/images/destinations/kozhikode-hero.webp"
>
  <Header />

  <main class="kozhikode-hotels-page">
    <!-- 1. HERO BANNER -->
    <section class="hotels-hero-section" aria-label="Kozhikode Hotels Header">
      <div class="hotels-hero-bg" aria-hidden="true">
        <img
          src="/images/destinations/kozhikode-hero.webp"
          alt="Scenic landscapes and curated hospitality in Kozhikode"
          width="1920"
          height="700"
          class="hotels-hero-image"
          loading="eager"
          decoding="async"
        />
        <div class="hotels-hero-veil"></div>
      </div>

      <div class="container hotels-hero-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="current" aria-current="page">Kozhikode Hotels</span>
        </nav>

        <div class="section-eyebrow hotels-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>CURATED KOZHIKODE HOSPITALITY</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 class="hotels-hero-title">
          Handpicked Hotels & Resorts <br />
          <span class="editorial-accent">in Kozhikode (Calicut)</span>
        </h1>

        <p class="hotels-hero-desc">
          The legendary City of Spices and historic port of Vasco da Gama, renowned for unmatched Malabar culinary traditions, bustling bazaars, and sunset beaches. Explore 10 verified properties curated by MakeMyKerala for an unforgettable Kerala holiday.
        </p>

        <div class="hotels-quick-stats">
          <div class="stat-bubble">
            <span class="bubble-num">10</span>
            <span class="bubble-text">Curated Stays</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">Verified</span>
            <span class="bubble-text">Direct Inspections</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">25&nbsp;Yrs</span>
            <span class="bubble-text">Local Kerala Expertise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. DIRECTORY SECTION WITH FILTER TABS -->
    <section class="section section-sand directory-section" aria-label="Hotel Directory">
      <div class="container">
        <!-- FILTER BAR -->
        <div class="hotels-filter-bar" role="tablist" aria-label="Filter hotels by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? "is-active" : ""}`}
              data-filter={cat}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- HOTELS GRID -->
        <div class="hotels-grid" id="hotels-grid">
          {kozhikodeHotels.map((hotel) => (
            <div
              class="hotel-grid-item"
              data-category={hotel.category}
              data-stars={hotel.starRating}
              data-locality={hotel.locality}
              data-slug={hotel.slug}
            >
              <HotelCard hotel={hotel} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CUSTOM TRIP PLANNING CTA -->
    <section class="section section-sand planning-banner reveal" aria-label="Plan Your Kerala Journey">
      <div class="container">
        <div class="banner-box">
          <div class="banner-content">
            <span class="banner-eyebrow">CUSTOM KERALA ITINERARIES</span>
            <h2 class="banner-title">
              Craft Your Bespoke <span class="accent-gold">Kozhikode Journey</span>
            </h2>
            <p class="banner-text">
              Looking for tailored itineraries combining Kozhikode with Munnar, Thekkady, Alleppey backwaters, and pristine beaches? Our local travel designers handcraft your trip with private chauffeurs and verified stays.
            </p>
            <div class="banner-actions">
              <a href="/packages/" class="btn-gold-banner">
                Explore Packages
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              <a href="https://wa.me/919447000000?text=Hi%2C%20I%20would%20like%20to%20plan%20a%20trip%20to%20Kozhikode" target="_blank" rel="noopener noreferrer" class="btn-outline-banner">
                Chat on WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- CLIENT-SIDE FILTER TAB SCRIPT -->
<script is:inline>
  (() => {
    const tabs = document.querySelectorAll('.filter-tab-btn');
    const items = document.querySelectorAll('.hotel-grid-item');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;

        items.forEach(item => {
          const cat = item.dataset.category || "";
          const stars = parseInt(item.dataset.stars || "0", 10);
          const locality = item.dataset.locality || "";

          let match = false;
          if (filter === "All Stays") {
            match = true;
          } else if (filter.includes("5-Star") || filter.includes("4-Star") || filter.includes("Luxury")) {
            match = stars >= 4 || cat.includes("4-Star") || cat.includes("5-Star") || cat.includes("Luxury");
          } else if (filter.includes("Beach") || filter.includes("Sea")) {
            match = cat.includes("Beach") || cat.includes("Sea") || locality.includes("Beach") || locality.includes("Cliff");
          } else if (filter.includes("Lake") || filter.includes("Backwater") || filter.includes("River")) {
            match = cat.includes("Lake") || cat.includes("Backwater") || cat.includes("River") || locality.includes("Lake") || locality.includes("River");
          } else if (filter.includes("Ayurved")) {
            match = cat.includes("Ayurved") || cat.includes("Wellness");
          } else if (filter.includes("Transit") || filter.includes("Airport") || filter.includes("City") || filter.includes("Station")) {
            match = cat.includes("Transit") || cat.includes("Airport") || cat.includes("City") || cat.includes("Station");
          } else {
            match = cat.toLowerCase().includes(filter.toLowerCase()) || locality.toLowerCase().includes(filter.toLowerCase());
          }

          item.style.display = match ? "block" : "none";
        });
      });
    });
  })();
</script>

<style>
  .kozhikode-hotels-page {
    background-color: var(--color-sand, #f7f3ea);
    min-height: 100vh;
  }

  .hotels-hero-section {
    position: relative;
    padding: 130px 0 64px;
    background-color: #0c1a17;
    color: #ffffff;
    overflow: hidden;
  }

  .hotels-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hotels-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.38;
  }

  .hotels-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 24, 20, 0.72) 0%,
      rgba(10, 24, 20, 0.88) 60%,
      #0c1a17 100%
    );
  }

  .hotels-hero-container {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #d4af37;
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.35);
  }

  .breadcrumb .current {
    color: #d4af37;
  }

  .hotels-eyebrow {
    color: #d4af37;
    margin-bottom: 12px;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .eyebrow-line {
    display: inline-block;
    width: 32px;
    height: 1px;
    background-color: #d4af37;
    opacity: 0.6;
  }

  .hotels-hero-title {
    font-family: var(--font-serif, "Poppins", sans-serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.18;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .editorial-accent {
    font-style: italic;
    color: #f3e5ab;
  }

  .hotels-hero-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 820px;
    margin: 0 auto 32px;
  }

  .hotels-quick-stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .stat-bubble {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 999px;
    padding: 8px 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(4px);
  }

  .bubble-num {
    font-family: var(--font-serif, "Poppins", sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #d4af37;
  }

  .bubble-text {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .directory-section {
    padding: 48px 0 80px;
  }

  .hotels-filter-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .filter-tab-btn {
    background: #ffffff;
    border: 1px solid rgba(20, 40, 35, 0.12);
    color: #142823;
    padding: 9px 20px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .filter-tab-btn:hover {
    border-color: #d4af37;
    color: #b0742a;
  }

  .filter-tab-btn.is-active {
    background-color: #142823;
    border-color: #142823;
    color: #ffffff;
  }

  .hotels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 32px;
  }

  @media (max-width: 640px) {
    .hotels-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .planning-banner {
    padding: 60px 0 90px;
  }

  .banner-box {
    background: linear-gradient(135deg, #142823 0%, #1f3d36 100%);
    border-radius: 20px;
    padding: 56px 48px;
    color: #ffffff;
    text-align: center;
    box-shadow: 0 16px 40px rgba(10, 24, 20, 0.16);
  }

  .banner-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: #d4af37;
    margin-bottom: 12px;
    display: block;
  }

  .banner-title {
    font-family: var(--font-serif, "Poppins", sans-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .accent-gold {
    color: #f3e5ab;
    font-style: italic;
  }

  .banner-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 720px;
    margin: 0 auto 32px;
  }

  .banner-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-gold-banner {
    background-color: #c88b3b;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.94rem;
    padding: 13px 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-gold-banner:hover {
    background-color: #b0742a;
    transform: translateY(-2px);
  }

  .btn-outline-banner {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.94rem;
    padding: 13px 24px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline-banner:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
  }
</style>
