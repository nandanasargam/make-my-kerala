  /* FILTER BAR */
  .directory-section {
    background-color: var(--color-sand-light, #fbf8f2);
    padding-block: clamp(60px, 8vw, 100px);
  }

  .hotels-filter-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }

