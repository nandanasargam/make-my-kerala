---
// src/pages/hotels/thekkady/index.astro
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import HotelCard from "../../../components/hotels/HotelCard.astro";
import { thekkadyHotels } from "../../../data/hotels.js";
import "../../../styles/global.css";

const pageTitle = "Thekkady Hotels & Jungle Resorts | 15 Handpicked Stays in Periyar - Make My Kerala";
const pageDescription = "Explore 15 curated hotels and eco-resorts in Thekkady and Kumily, Kerala. From Periyar Wildlife Sanctuary lakeside lodges and spice plantation estates to boutique luxury retreats.";

const categories = [
  "All Stays",
  "Wildlife & Sanctuary",
  "Eco & Nature Resorts",
  "4 & 5-Star Luxury",
  "Town & Cultural"
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/images/thekkady.webp"
>
  <Header />

  <main class="thekkady-hotels-page">
    <!-- 1. HERO BANNER -->
    <section class="hotels-hero-section" aria-label="Thekkady Hotels Header">
      <div class="hotels-hero-bg" aria-hidden="true">
        <img
          src="/images/thekkady.webp"
          alt="Lush tropical forests, Periyar Lake and misty wildlife hills of Thekkady"
          width="1920"
          height="700"
          class="hotels-hero-image"
          loading="eager"
          decoding="async"
        />
        <div class="hotels-hero-veil"></div>
      </div>

      <div class="container hotels-hero-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="current" aria-current="page">Thekkady Hotels</span>
        </nav>

        <div class="section-eyebrow hotels-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>CURATED PERIYAR HOSPITALITY</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 class="hotels-hero-title">
          Handpicked Hotels & Eco-Resorts <br />
          <span class="editorial-accent">in Thekkady & Periyar</span>
        </h1>

        <p class="hotels-hero-desc">
          Thekkady is Kerala’s legendary wild frontier of elephant corridors, aromatic cardamom hills, and misty sanctuary waters. Whether you seek colonial heritage lodges inside Periyar Tiger Reserve, luxury forest pool chalets, or serene spice estate sanctuaries, explore 15 verified properties curated by MakeMyKerala.
        </p>

        <div class="hotels-quick-stats">
          <div class="stat-bubble">
            <span class="bubble-num">15</span>
            <span class="bubble-text">Verified Resorts</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">Periyar</span>
            <span class="bubble-text">Sanctuary Stays</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">25&nbsp;Yrs</span>
            <span class="bubble-text">Local Destination Expertise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. DIRECTORY SECTION WITH FILTER TABS -->
    <section class="section section-sand directory-section" aria-label="Hotel Directory">
      <div class="container">
        <!-- FILTER BAR -->
        <div class="hotels-filter-bar" role="tablist" aria-label="Filter hotels by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? "is-active" : ""}`}
              data-filter={cat}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- 15 HOTELS GRID -->
        <div class="hotels-grid" id="hotels-grid">
          {thekkadyHotels.map((hotel) => (
            <div
              class="hotel-grid-item"
              data-category={hotel.category}
              data-stars={hotel.starRating}
              data-locality={hotel.locality}
              data-slug={hotel.slug}
            >
              <HotelCard hotel={hotel} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. NEIGHBORHOOD GUIDE -->
    <section class="section guide-section reveal" aria-label="Thekkady Neighborhood Guide">
      <div class="container">
        <div class="section-head section-head-center">
          <div class="section-eyebrow">
            <span class="eyebrow-dash" aria-hidden="true">—</span>
            <span>WHERE TO STAY IN THEKKADY</span>
          </div>
          <h2 class="section-title">
            Choosing Your <span class="editorial-accent">Periyar & Kumily Belt</span>
          </h2>
          <p class="section-lede">
            From historic sanctuary boundaries to rolling spice valley hills, discover the distinct character of Thekkady's prime stay localities.
          </p>
        </div>

        <div class="neighborhoods-grid">
          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Inside Tiger Reserve</span>
              <h3 class="n-title">Periyar Wildlife Sanctuary Boundary</h3>
            </div>
            <p class="n-desc">
              Situated right within the protected sanctuary boundaries, offering direct proximity to early morning boat safaris, jungle patrols, and untamed forest atmospheres.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Stays:</span>
              <span class="n-names">Aranya Nivas KTDC, Periyar House KTDC</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Eco-Luxury & Spas</span>
              <h3 class="n-title">Kumily-Thekkady Road & Forest Enclaves</h3>
            </div>
            <p class="n-desc">
              Lush forested hill ridges home to five-star eco-luxury retreats, private pool villas, Ayurvedic wellness sanctuaries, and canopy dining under dense indigenous trees.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Resorts:</span>
              <span class="n-names">The Elephant Court, Greenwoods Resort, ABAD Green Forest, Woodnote Resort</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Spice Plantations</span>
              <h3 class="n-title">Spring Valley & Vandiperiyar</h3>
            </div>
            <p class="n-desc">
              Perched slightly away from town amidst organic cardamom, pepper, and coffee plantations. Offers cool breezes, mountain infinity pools, and guided nature discovery walks.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Stays:</span>
              <span class="n-names">Springdale Heritage, Coffee Routes, Sterling Thekkady</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Town & Culture</span>
              <h3 class="n-title">Kumily Town Center & Bypass</h3>
            </div>
            <p class="n-desc">
              Walking distance to spice bazaars, Kathakali and Kalaripayattu cultural theatres, artisanal craft emporiums, and convenient transit links.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Hotels:</span>
              <span class="n-names">Holiday Vista, Hotel Sandra Palace, Grand Thekkady, Peppervine</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CUSTOM TRIP PLANNING CTA -->
    <section class="section section-sand planning-banner reveal" aria-label="Plan Your Kerala Journey">
      <div class="container">
        <div class="banner-box">
          <div class="banner-content">
            <span class="banner-eyebrow">CUSTOM KERALA ITINERARIES</span>
            <h2 class="banner-title">
              Pair Your Thekkady Safari with <span class="accent-gold">Munnar, Alleppey & Kochi</span>
            </h2>
            <p class="banner-text">
              A classic Kerala circuit connects the misty peaks of Munnar to the cardamom forests of Thekkady, finishing with a tranquil houseboat cruise in Alleppey. Let MakeMyKerala's destination specialists craft your seamless private journey.
            </p>
            <div class="banner-actions">
              <a href="/contact" class="btn-gold-banner">
                <span>Design Custom Itinerary</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="tel:+919876543210" class="btn-outline-banner">
                <span>Speak with a Specialist: +91 98765 43210</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- CLIENT-SIDE FILTER TAB SCRIPT -->
<script is:inline>
  (() => {
    const tabs = document.querySelectorAll('.filter-tab-btn');
    const items = document.querySelectorAll('.hotel-grid-item');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;

        items.forEach(item => {
          const cat = item.dataset.category || "";
          const stars = parseInt(item.dataset.stars || "0", 10);
          const locality = item.dataset.locality || "";
          const slug = item.dataset.slug || "";

          let match = false;
          if (filter === "All Stays") {
            match = true;
          } else if (filter === "Wildlife & Sanctuary") {
            match = slug === "aranya-nivas" || slug === "periyar-house" || cat.includes("Wildlife") || cat.includes("Sanctuary");
          } else if (filter === "Eco & Nature Resorts") {
            match = cat.includes("Nature") || cat.includes("Eco") || cat.includes("Plantation") || cat.includes("Resort") || slug === "coffee-routes" || slug === "greenwoods-resort";
          } else if (filter === "4 & 5-Star Luxury") {
            match = stars >= 4 || cat.includes("5-Star") || cat.includes("4-Star") || slug === "the-elephant-court" || slug === "woodnote-thekkady" || slug === "greenwoods-resort";
          } else if (filter === "Town & Cultural") {
            match = cat.includes("City") || cat.includes("Town") || locality.includes("Kumily") || slug === "holiday-vista" || slug === "sandra-palace" || slug === "grand-thekkady";
          }

          if (match) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  })();
</script>

<style>
