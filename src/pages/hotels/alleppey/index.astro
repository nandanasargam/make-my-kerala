    color: #cbd5e1;
    margin-bottom: 32px;
  }

  .banner-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-gold-banner {
    background-color: var(--color-gold, #c88b3b);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.94rem;
    padding: 13px 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-gold-banner:hover {
    background-color: var(--color-gold-hover, #b0742a);
    transform: translateY(-2px);
  }

  .btn-outline-banner {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.94rem;
    padding: 13px 24px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-outline-banner:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
  }
</style>
