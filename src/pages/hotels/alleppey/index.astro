    letter-spacing: 0.12em;
    color: #f7d59b;
    display: block;
    margin-bottom: 12px;
  }

  .banner-title {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(2rem, 3.4vw, 3rem);
