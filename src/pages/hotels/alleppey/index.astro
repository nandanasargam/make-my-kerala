---
// src/pages/hotels/alleppey/index.astro
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import HotelCard from "../../../components/hotels/HotelCard.astro";
import { alleppeyHotels } from "../../../data/hotels.js";
import "../../../styles/global.css";

const pageTitle = "Alleppey Hotels & Backwater Resorts | 15 Handpicked Stays in Alappuzha - Make My Kerala";
const pageDescription = "Explore 15 curated hotels and backwater resorts in Alleppey (Alappuzha), Kerala. From Lake Vembanad luxury pool villas and canal-side boutique stays to town center transit hotels.";

const categories = [
  "All Stays",
  "Backwater & Lakefront",
  "4 & 5-Star Luxury",
  "Town & Transit",
  "Heritage & Palace"
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/images/allapey.webp"
>
  <Header />

  <main class="alleppey-hotels-page">
    <!-- 1. HERO BANNER -->
    <section class="hotels-hero-section" aria-label="Alleppey Hotels Header">
      <div class="hotels-hero-bg" aria-hidden="true">
        <img
          src="/images/allapey.webp"
          alt="Tranquil backwaters, swaying coconut palms and traditional houseboats of Alleppey"
          width="1920"
          height="700"
          class="hotels-hero-image"
          loading="eager"
          decoding="async"
        />
        <div class="hotels-hero-veil"></div>
      </div>

      <div class="container hotels-hero-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="current" aria-current="page">Alleppey Hotels</span>
        </nav>

        <div class="section-eyebrow hotels-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>CURATED BACKWATER HOSPITALITY</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 class="hotels-hero-title">
          Handpicked Hotels & Backwater Resorts <br />
          <span class="editorial-accent">in Alleppey (Alappuzha)</span>
        </h1>

        <p class="hotels-hero-desc">
          Known as the 'Venice of the East', Alappuzha is Kerala’s labyrinthine wonderland of shimmering lagoons, palm-fringed canals, and peaceful village life. Whether you seek five-star lakefront sanctuaries, private houseboat docks, or central town stays, discover 15 verified properties curated by MakeMyKerala.
        </p>

        <div class="hotels-quick-stats">
          <div class="stat-bubble">
            <span class="bubble-num">15</span>
            <span class="bubble-text">Verified Stays</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">Lakefront</span>
            <span class="bubble-text">Backwater Hubs</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">25&nbsp;Yrs</span>
            <span class="bubble-text">Local Destination Expertise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. DIRECTORY SECTION WITH FILTER TABS -->
    <section class="section section-sand directory-section" aria-label="Hotel Directory">
      <div class="container">
        <!-- FILTER BAR -->
        <div class="hotels-filter-bar" role="tablist" aria-label="Filter hotels by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? "is-active" : ""}`}
              data-filter={cat}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- 15 HOTELS GRID -->
        <div class="hotels-grid" id="hotels-grid">
          {alleppeyHotels.map((hotel) => (
            <div
              class="hotel-grid-item"
              data-category={hotel.category}
              data-stars={hotel.starRating}
              data-locality={hotel.locality}
              data-slug={hotel.slug}
            >
              <HotelCard hotel={hotel} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. NEIGHBORHOOD GUIDE -->
    <section class="section guide-section reveal" aria-label="Alleppey Neighborhood Guide">
      <div class="container">
        <div class="section-head section-head-center">
          <div class="section-eyebrow">
            <span class="eyebrow-dash" aria-hidden="true">—</span>
            <span>WHERE TO STAY IN ALLEPPEY</span>
          </div>
          <h2 class="section-title">
            Choosing Your <span class="editorial-accent">Backwater & Coastal Region</span>
          </h2>
          <p class="section-lede">
            Alleppey's distinct waterways offer everything from quiet village lake shores to vibrant boat-racing hub corridors.
          </p>
        </div>

        <div class="neighborhoods-grid">
          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Boat Racing & Docks</span>
              <h3 class="n-title">Punnamada & Finishing Point</h3>
            </div>
            <p class="n-desc">
              Home to the world-famous Nehru Trophy Boat Race. Offers prime front-row views of majestic snake boat practice sessions, private houseboat boarding jetties, and quick access to town.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Resorts:</span>
              <span class="n-names">Ramada by Wyndham Alleppey, Sterling Lake Palace, Pagoda Resorts</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Serene Lakefront</span>
              <h3 class="n-title">Vembanad & Maradu Waters</h3>
            </div>
            <p class="n-desc">
              Expansive lakefront vistas across India’s longest lake. Enjoy authentic Ayurvedic spa sanctuaries, sunset speed-boat excursions, infinity pools over the water, and serene peace.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Resorts:</span>
              <span class="n-names">Uday Backwater Resort, Paloma Backwater Resorts, Haveli Backwater Resort</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Town & Transit Hub</span>
              <h3 class="n-title">Iron Bridge & Town Center</h3>
            </div>
            <p class="n-desc">
              Walking distance to commercial spice markets, coir emporiums, KSRTC transit, and Alleppey railway junction. Perfect for travelers seeking transit efficiency and dining variety.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Hotels:</span>
              <span class="n-names">Hotel Arcadia Regency, Alleppey Prince Hotel, Venice Iva Residency, Padippura Residency</span>
            </div>
          </div>

          <div class="neighborhood-card">
            <div class="n-head">
              <span class="n-badge">Heritage & Highway</span>
              <h3 class="n-title">Cherthala & NH 66 Corridor</h3>
            </div>
            <p class="n-desc">
              Located on the northern arterial corridor connecting Kochi to Alleppey. Features majestic Travancore-style palaces, expansive convention facilities, and effortless access to Marari Beach.
            </p>
            <div class="n-hotels">
              <span class="n-label">Featured Stays:</span>
              <span class="n-names">Travancore Palace Hotel, Camelot Hotel, Hotel Bonanza</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CUSTOM TRIP PLANNING CTA -->
    <section class="section section-sand planning-banner reveal" aria-label="Plan Your Kerala Journey">
      <div class="container">
        <div class="banner-box">
          <div class="banner-content">
            <span class="banner-eyebrow">CUSTOM KERALA ITINERARIES</span>
            <h2 class="banner-title">
              Pair Your Backwater Stay with <span class="accent-gold">Kochi, Munnar & Thekkady</span>
            </h2>
            <p class="banner-text">
              An authentic Kerala holiday typically culminates with backwater serenity in Alleppey after visiting Kochi's colonial forts, Munnar's tea hills, and Thekkady's wildlife reserves. Let our local planners design your private tour.
            </p>
            <div class="banner-actions">
              <a href="/contact" class="btn-gold-banner">
                <span>Design Custom Itinerary</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="tel:+919876543210" class="btn-outline-banner">
                <span>Speak with a Specialist: +91 98765 43210</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- CLIENT-SIDE FILTER TAB SCRIPT -->
<script is:inline>
  (() => {
    const tabs = document.querySelectorAll('.filter-tab-btn');
    const items = document.querySelectorAll('.hotel-grid-item');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;

        items.forEach(item => {
          const cat = item.dataset.category || "";
          const stars = parseInt(item.dataset.stars || "0", 10);
          const locality = item.dataset.locality || "";
          const slug = item.dataset.slug || "";

          let match = false;
          if (filter === "All Stays") {
            match = true;
          } else if (filter === "Backwater & Lakefront") {
            match = cat.includes("Backwater") || cat.includes("Lake") || slug === "ramada-alleppey" || slug === "sterling-lake-palace" || slug === "uday-backwater-resort" || slug === "paloma-backwater-resort" || slug === "haveli-backwater-resort";
          } else if (filter === "4 & 5-Star Luxury") {
            match = stars >= 4 || cat.includes("5-Star") || cat.includes("4-Star") || slug === "ramada-alleppey" || slug === "sterling-lake-palace" || slug === "uday-backwater-resort";
          } else if (filter === "Town & Transit") {
            match = cat.includes("City") || cat.includes("Town") || locality.includes("Iron Bridge") || slug === "arcadia-regency" || slug === "alleppey-prince" || slug === "venice-iva-residency" || slug === "classic-residency" || slug === "padippura-residency";
          } else if (filter === "Heritage & Palace") {
            match = cat.includes("Heritage") || cat.includes("Palace") || slug === "travancore-palace" || slug === "camelot-hotel" || slug === "sterling-lake-palace";
          }

          if (match) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  })();
</script>

<style>
  /* HERO SECTION */
  .hotels-hero-section {
    position: relative;
    padding-top: clamp(60px, 8vw, 100px);
    padding-bottom: clamp(60px, 9vw, 110px);
    color: #ffffff;
    overflow: hidden;
    background-color: #061913;
  }

  .hotels-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hotels-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hotels-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(6, 25, 19, 0.8) 0%,
      rgba(6, 25, 19, 0.9) 65%,
      rgba(6, 25, 19, 0.98) 100%
    );
  }

  .hotels-hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 880px;
    margin-inline: auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 24px;
    font-family: var(--font-body);
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: #f7d59b;
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: #ffffff;
    font-weight: 600;
  }

  .hotels-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-eyebrow, "Space Grotesk", sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #f7d59b;
    margin-bottom: 18px;
  }

  .eyebrow-line {
    width: 28px;
    height: 1px;
    background-color: #f7d59b;
    opacity: 0.7;
  }

  .hotels-hero-title {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    line-height: 1.15;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 18px;
  }

  .editorial-accent {
    font-style: italic;
    color: #f7d59b;
  }

  .hotels-hero-desc {
    font-size: clamp(1.05rem, 1.35vw, 1.22rem);
    line-height: 1.7;
    color: #d1dcda;
    max-width: 68ch;
    margin-bottom: 36px;
  }

  .hotels-quick-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    background-color: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 16px 32px;
    border-radius: 999px;
  }

  .stat-bubble {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .bubble-num {
    font-family: var(--font-eyebrow, "Space Grotesk", sans-serif);
    font-size: 1.3rem;
    font-weight: 800;
    color: #f7d59b;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bubble-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: #f1f5f9;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .hotels-hero-section {
      padding-top: clamp(32px, 6vw, 48px);
      padding-bottom: clamp(48px, 8vw, 72px);
    }

    .hotels-hero-container {
      padding-inline: clamp(12px, 3.5vw, 24px);
    }

    .breadcrumb {
      margin-bottom: 16px;
    }

    .hotels-eyebrow {
      margin-bottom: 14px;
    }

    .hotels-hero-title {
      font-size: clamp(1.9rem, 6.4vw, 2.6rem);
      line-height: 1.18;
      margin-bottom: 14px;
    }

    .hotels-hero-desc {
      font-size: clamp(0.92rem, 3vw, 1.05rem);
      line-height: 1.6;
      max-width: 48ch;
      margin-bottom: 24px;
    }

    .hotels-quick-stats {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      width: 100%;
      max-width: 360px;
      margin-inline: auto;
      padding: 22px 20px;
      border-radius: 999px;
      box-sizing: border-box;
    }

    .stat-bubble {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }

    .bubble-num {
      font-size: clamp(1.05rem, 3.4vw, 1.25rem);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .bubble-text {
      font-size: clamp(0.7rem, 2.1vw, 0.78rem);
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
  }

  @media (max-width: 350px) {
    .hotels-quick-stats {
      padding: 18px 12px;
      gap: 11px;
    }

    .bubble-num {
      font-size: 1rem;
    }

    .bubble-text {
      font-size: 0.65rem;
      letter-spacing: 0.02em;
    }
  }

  /* FILTER BAR */
  .directory-section {
    background-color: var(--color-sand-light, #fbf8f2);
    padding-block: clamp(60px, 8vw, 100px);
  }

  .hotels-filter-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }

  .filter-tab-btn {
    border: 1px solid var(--color-border, #e0d8cb);
    background-color: #ffffff;
    color: var(--color-forest, #0d2e23);
    font-family: var(--font-eyebrow, "Space Grotesk", sans-serif);
    font-size: 0.84rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(6, 25, 19, 0.04);
  }

  .filter-tab-btn:hover {
    border-color: var(--color-gold, #c88b3b);
    color: var(--color-gold, #c88b3b);
  }

  .filter-tab-btn.is-active {
    background-color: var(--color-forest, #0d2e23);
    color: #ffffff;
    border-color: var(--color-forest, #0d2e23);
    box-shadow: 0 4px 14px rgba(6, 25, 19, 0.15);
  }

  /* GRID */
  .hotels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 1100px) {
    .hotels-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 680px) {
    .hotels-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* NEIGHBORHOOD GUIDE */
  .guide-section {
    background-color: #ffffff;
    padding-block: clamp(70px, 9vw, 110px);
  }

  .eyebrow-dash {
    color: var(--color-gold, #c88b3b);
    font-weight: 800;
  }

  .neighborhoods-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  @media (max-width: 800px) {
    .neighborhoods-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .neighborhood-card {
    background: linear-gradient(135deg, #ffffff 0%, var(--color-ivory, #f7f3ea) 100%);
    border: 1px solid var(--color-border, #e0d8cb);
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--shadow-sm);
  }

  .n-badge {
    background-color: rgba(200, 139, 59, 0.15);
    color: #b0742a;
    font-family: var(--font-eyebrow, "Space Grotesk", sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .n-title {
    font-family: var(--font-display, "Fraunces", serif);
    font-size: 1.45rem;
    color: var(--color-forest, #0d2e23);
    margin: 0;
  }

  .n-desc {
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-muted, #53645b);
    margin: 0;
  }

  .n-hotels {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-subtle, rgba(13, 46, 35, 0.08));
