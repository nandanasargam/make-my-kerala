    gap: 8px;
    font-size: 0.84rem;
    flex-wrap: wrap;
  }

  .n-label {
    font-weight: 700;
    color: var(--color-forest, #0d2e23);
  }

  .n-names {
    color: var(--color-gold, #c88b3b);
    font-weight: 600;
  }

  /* PLANNING BANNER */
  .planning-banner {
    background-color: var(--color-sand-light, #fbf8f2);
    padding-block: clamp(60px, 8vw, 100px);
  }

  .banner-box {
    background: linear-gradient(135deg, #0d2e23 0%, #061913 100%);
    border-radius: 24px;
