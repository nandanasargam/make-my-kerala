---
// src/pages/hotels/tamil-nadu/madurai/index.astro
import Layout from "../../../../layouts/Layout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import HotelCard from "../../../../components/hotels/HotelCard.astro";
import { maduraiHotels } from "../../../../data/hotels.js";
import "../../../../styles/global.css";

const pageTitle = "Madurai Hotels & Stays | 10 Handpicked Hotels in Madurai - Make My Kerala";
const pageDescription = "Explore 10 curated hotels and stays in Madurai, Tamil Nadu. Known as the Athens of the East, home to the legendary Meenakshi Amman Temple, Thirumalai Nayakkar Palace, and rich Dravidian cultural heritage. Verified properties curated by MakeMyKerala.";

const categories = [
  "All Stays",
  "Temple Proximity",
  "4-Star Luxury",
  "Railway Junction",
  "Heritage & Culture"
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/images/destinations/madurai-hero.webp"
>
  <Header />

  <main class="madurai-hotels-page">
    <!-- 1. HERO BANNER -->
    <section class="hotels-hero-section" aria-label="Madurai Hotels Header">
      <div class="hotels-hero-bg" aria-hidden="true">
        <img
          src="/images/destinations/madurai-hero.webp"
          alt="Scenic landscapes and curated hospitality in Madurai"
          width="1920"
          height="700"
          class="hotels-hero-image"
          loading="eager"
          decoding="async"
        />
        <div class="hotels-hero-veil"></div>
      </div>

      <div class="container hotels-hero-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href="/hotels/tamil-nadu/">Tamil Nadu</a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="current" aria-current="page">Madurai Hotels</span>
        </nav>

        <div class="section-eyebrow hotels-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>CURATED MADURAI HOSPITALITY</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 class="hotels-hero-title">
          Handpicked Hotels & Stays <br />
          <span class="editorial-accent">in Madurai</span>
        </h1>

        <p class="hotels-hero-desc">
           Known as the Athens of the East, home to the legendary Meenakshi Amman Temple, Thirumalai Nayakkar Palace, and rich Dravidian cultural heritage. Explore 10 verified properties curated by MakeMyKerala.
        </p>

        <div class="hotels-quick-stats">
          <div class="stat-bubble">
            <span class="bubble-num">10</span>
            <span class="bubble-text">Curated Stays</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">Verified</span>
            <span class="bubble-text">Direct Inspections</span>
          </div>
          <div class="stat-bubble">
            <span class="bubble-num">25&nbsp;Yrs</span>
            <span class="bubble-text">Local South India Expertise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. DIRECTORY SECTION WITH FILTER TABS -->
    <section class="section section-sand directory-section" aria-label="Hotel Directory">
      <div class="container">
        <!-- FILTER BAR -->
        <div class="hotels-filter-bar" role="tablist" aria-label="Filter hotels by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-tab-btn ${idx === 0 ? "is-active" : ""}`}
              data-filter={cat}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- HOTELS GRID -->
        <div class="hotels-grid" id="hotels-grid">
          {maduraiHotels.map((hotel) => (
            <div
              class="hotel-grid-item"
              data-category={hotel.category}
              data-stars={hotel.starRating}
              data-locality={hotel.locality}
              data-slug={hotel.slug}
            >
              <HotelCard hotel={hotel} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CUSTOM TRIP PLANNING CTA -->
    <section class="section section-sand planning-banner reveal" aria-label="Plan Your South India Journey">
      <div class="container">
        <div class="banner-box">
          <div class="banner-content">
            <span class="banner-eyebrow">CUSTOM SOUTH INDIA ITINERARIES</span>
            <h2 class="banner-title">
              Craft Your Bespoke <span class="accent-gold">Madurai Journey</span>
            </h2>
            <p class="banner-text">
              Looking for tailored itineraries combining Madurai with Kerala hill stations, backwaters, Madurai, Kanyakumari, and Rameshwaram? Our local travel designers handcraft your trip with private chauffeurs and verified stays.
            </p>
            <div class="banner-actions">
              <a href="/packages/" class="btn-gold-banner">
                Explore Packages
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              <a href="https://wa.me/919447000000?text=Hi%2C%20I%20would%20like%20to%20plan%20a%20trip%20to%20Madurai" target="_blank" rel="noopener noreferrer" class="btn-outline-banner">
                Chat on WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- CLIENT-SIDE FILTER TAB SCRIPT -->
<script is:inline>
  (() => {
    const tabs = document.querySelectorAll('.filter-tab-btn');
    const items = document.querySelectorAll('.hotel-grid-item');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;

        items.forEach(item => {
          const cat = item.dataset.category || "";
          const stars = parseInt(item.dataset.stars || "0", 10);
          const locality = item.dataset.locality || "";

          let match = false;
          if (filter === "All Stays") {
            match = true;
          } else if (filter.includes("5-Star") || filter.includes("4-Star") || filter.includes("Luxury")) {
            match = stars >= 4 || cat.includes("4-Star") || cat.includes("5-Star") || cat.includes("Luxury");
          } else if (filter.includes("Beach") || filter.includes("Ocean") || filter.includes("Sea")) {
            match = cat.includes("Beach") || cat.includes("Ocean") || cat.includes("Sea") || locality.includes("Beach") || locality.includes("Coast");
          } else if (filter.includes("Temple") || filter.includes("Pilgrim")) {
            match = cat.includes("Pilgrim") || locality.includes("Temple") || locality.includes("Car Street") || locality.includes("Sannathi");
          } else if (filter.includes("Railway") || filter.includes("Station") || filter.includes("Junction")) {
            match = locality.includes("Railway") || locality.includes("Station") || locality.includes("Junction") || locality.includes("Perumal");
          } else {
            match = cat.toLowerCase().includes(filter.toLowerCase()) || locality.toLowerCase().includes(filter.toLowerCase());
          }

          item.style.display = match ? "block" : "none";
        });
      });
    });
  })();
</script>

<style>
  .madurai-hotels-page {
    background-color: var(--color-sand, #f7f3ea);
    min-height: 100vh;
  }

  .hotels-hero-section {
    position: relative;
    padding: 130px 0 64px;
    background-color: #0c1a17;
    color: #ffffff;
    overflow: hidden;
  }

  .hotels-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hotels-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.38;
  }

  .hotels-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 24, 20, 0.72) 0%,
      rgba(10, 24, 20, 0.88) 60%,
      #0c1a17 100%
    );
  }

  .hotels-hero-container {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-gold, #c88b3b);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--color-gold, #c88b3b);
    font-weight: 600;
  }

  .hotels-eyebrow {
    color: var(--color-gold, #c88b3b);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .eyebrow-line {
    width: 32px;
    height: 1px;
    background: var(--color-gold, #c88b3b);
    display: inline-block;
  }

  .hotels-hero-title {
    font-family: var(--font-heading, "Playfair Display", serif);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.15;
    margin-bottom: 16px;
    font-weight: 700;
  }

  .editorial-accent {
    color: var(--color-gold, #c88b3b);
    font-style: italic;
  }

  .hotels-hero-desc {
    font-size: clamp(0.95rem, 1.6vw, 1.12rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 820px;
    margin: 0 auto 36px;
  }

  .hotels-quick-stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .stat-bubble {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 8px 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bubble-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-gold, #c88b3b);
  }

  .bubble-text {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .directory-section {
    padding: 48px 0 72px;
  }

  .hotels-filter-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .filter-tab-btn {
    background: #ffffff;
    border: 1px solid var(--color-border-subtle, rgba(18, 56, 42, 0.12));
    border-radius: 999px;
    padding: 10px 22px;
    font-family: var(--font-body, "Poppins", sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-forest, #12382a);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-tab-btn:hover {
    border-color: var(--color-gold, #c88b3b);
    color: var(--color-gold, #c88b3b);
    transform: translateY(-1px);
  }

  .filter-tab-btn.is-active {
    background: var(--color-forest, #12382a);
    color: #ffffff;
    border-color: var(--color-forest, #12382a);
  }

  .hotels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  .planning-banner {
    padding-bottom: 80px;
  }

  .banner-box {
    background: linear-gradient(135deg, #12382a 0%, #1d4d3a 100%);
    border-radius: 20px;
    padding: 48px 40px;
    color: #ffffff;
    box-shadow: 0 16px 40px rgba(18, 56, 42, 0.18);
    position: relative;
    overflow: hidden;
  }

  .banner-box::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(200, 139, 59, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .banner-content {
    max-width: 680px;
    position: relative;
    z-index: 1;
  }

  .banner-eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-gold, #c88b3b);
    display: block;
    margin-bottom: 8px;
  }

  .banner-title {
    font-family: var(--font-heading, "Playfair Display", serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 14px;
    line-height: 1.25;
  }

  .accent-gold {
    color: var(--color-gold, #c88b3b);
  }

  .banner-text {
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 28px;
  }

  .banner-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-gold-banner {
    background-color: var(--color-gold, #c88b3b);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }

  .btn-gold-banner:hover {
    background-color: #b57a2c;
    transform: translateY(-2px);
  }

  .btn-outline-banner {
    background-color: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    font-weight: 600;
    font-size: 0.92rem;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-outline-banner:hover {
    border-color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .banner-box {
      padding: 32px 24px;
    }
  }
</style>
