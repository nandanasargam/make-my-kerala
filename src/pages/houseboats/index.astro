---
// src/pages/houseboats/index.astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { houseboatsData, authenticDiningMenu, cruiseSchedule } from "../../data/houseboatsData.js";
import "../../styles/global.css";

const threeBedroom = houseboatsData.find((h) => h.id === "three-bedroom");
const sixBedroom = houseboatsData.find((h) => h.id === "six-bedroom");
const tenBedroom = houseboatsData.find((h) => h.id === "ten-bedroom");
---

<Layout
  title="Kerala Houseboats & Backwater Cruises | Alleppey & Kumarakom | MakeMyKerala"
  description="Experience luxury handcrafted Kettuvallam houseboats across Alleppey and Kumarakom. Choose from 3-bedroom, 6-bedroom, and 10-bedroom private houseboats with personal chefs and all-inclusive Kerala meals."
>
  <Header />

  <main id="main-content" class="houseboats-page">
    <!-- ===================================================
         01 — IMMERSIVE HERO
    =================================================== -->
    <section class="houseboat-hero-section">
      <div class="houseboat-hero-bg">
        <img
          src="/images/houseboats/hero.webp"
          alt="Luxury Kerala Houseboat cruising on Alleppey Backwaters"
          width="1920"
          height="800"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-img"
        />
        <div class="hero-overlay"></div>
      </div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-icon">✦</span>
            <span>SIGNATURE KERALA WATERWAYS • ALLEPPEY & KUMARAKOM</span>
          </div>

          <h1 class="hero-title">
            Experience the <span class="editorial-accent">Backwaters of Kerala</span>
          </h1>

          <p class="hero-lede">
            Drift along quiet emerald canals, vast open lagoons, and lush coconut palm corridors aboard handcrafted Kettuvallam houseboats. Savor traditional Kerala feasts prepared live by your personal onboard chef while the sun sets over Lake Vembanad.
          </p>

          <!-- QUICK PILLARS -->
          <div class="hero-pillars">
            <div class="pillar-item">
              <span class="pillar-icon">👨‍🍳</span>
              <div class="pillar-text">
                <strong>Private Chef</strong>
                <span>Live Kerala banquets</span>
              </div>
            </div>

            <div class="pillar-item">
              <span class="pillar-icon">❄️</span>
              <div class="pillar-text">
                <strong>AC Staterooms</strong>
                <span>En-suite bathrooms</span>
              </div>
            </div>

            <div class="pillar-item">
              <span class="pillar-icon">🛶</span>
              <div class="pillar-text">
                <strong>Private Cruise</strong>
                <span>Alleppey & Kumarakom</span>
              </div>
            </div>

            <div class="pillar-item">
              <span class="pillar-icon">🛡️</span>
              <div class="pillar-text">
                <strong>Verified Crew</strong>
                <span>Safety certified</span>
              </div>
            </div>
          </div>

          <div class="hero-actions">
            <a href="#three-bedroom" class="btn btn-primary">
              Explore Houseboats
              <span class="btn-arrow" aria-hidden="true">↓</span>
            </a>
            <a href="#book-houseboat" class="btn btn-outline-white">
              Enquire Custom Cruise
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================
         CATEGORY NAVIGATION TABS
    =================================================== -->
    <nav class="category-nav-bar" aria-label="Houseboat Categories">
      <div class="container">
        <ul class="category-tabs-list">
          <li>
            <a href="#three-bedroom" class="cat-tab-link active">
              <span class="cat-tab-num">01</span>
              <span class="cat-tab-label">3 Bedroom Houseboat</span>
              <span class="cat-tab-sub">6 – 9 Guests</span>
            </a>
          </li>
          <li>
            <a href="#six-bedroom" class="cat-tab-link">
              <span class="cat-tab-num">02</span>
              <span class="cat-tab-label">6 Bedroom Houseboat</span>
              <span class="cat-tab-sub">12 – 18 Guests</span>
            </a>
          </li>
          <li>
            <a href="#ten-bedroom" class="cat-tab-link">
              <span class="cat-tab-num">03</span>
              <span class="cat-tab-label">10 Bedroom Houseboat</span>
              <span class="cat-tab-sub">20 – 30 Guests</span>
            </a>
          </li>
          <li>
            <a href="#dining-experience" class="cat-tab-link">
              <span class="cat-tab-num">04</span>
              <span class="cat-tab-label">Dining & Schedule</span>
              <span class="cat-tab-sub">Traditional Menu</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- ===================================================
         02 — THREE BEDROOM HOUSEBOAT (SECTION 1)
    =================================================== -->
    {threeBedroom && (
      <section id="three-bedroom" class="houseboat-section section-forest-dark" aria-labelledby="heading-3bed">
        <div class="container">
          <!-- SECTION INTRO -->
          <div class="boat-section-head">
            <div class="section-tag-group">
              <span class="badge-accent">FEATURED EXPERIENCE</span>
              <span class="badge-sub">{threeBedroom.categoryBadge}</span>
            </div>

            <div class="boat-title-wrap">
              <h2 id="heading-3bed" class="boat-main-title">
                {threeBedroom.category}
              </h2>
              <span class="boat-capacity-tag">Capacity: {threeBedroom.capacity}</span>
            </div>

            <p class="boat-tagline">{threeBedroom.tagline}</p>
            <p class="boat-overview">{threeBedroom.overview}</p>

            <!-- QUICK SPECS GRID -->
            <div class="specs-grid">
              {threeBedroom.specifications.map((spec) => (
                <div class="spec-card">
                  <span class="spec-label">{spec.label}</span>
                  <span class="spec-val">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- PREMIUM VISUAL GALLERY COMPOSITION -->
          <div class="boat-gallery-wrapper">
            <div class="gallery-lead">
              <h3 class="gallery-heading">Verified Photo Showcase</h3>
              <p class="gallery-sub">Authentic exterior and interior photographs from our active Three Bedroom backwater fleet.</p>
            </div>

            <div class="three-bed-visual-layout">
              <!-- FEATURED LARGE IMAGE -->
              <div class="featured-photo-card">
                <div class="photo-contain-box">
                  <img
                    src={threeBedroom.gallery[0].src}
                    alt={threeBedroom.gallery[0].alt}
                    width="1200"
                    height="728"
                    loading="lazy"
                    decoding="async"
                    class="photo-img-contain"
                  />
                  <div class="photo-ambient-bg" style={`background-image: url('${threeBedroom.gallery[0].src}')`} aria-hidden="true"></div>
                </div>
                <div class="photo-caption-bar">
                  <span class="photo-caption-text">{threeBedroom.gallery[0].caption}</span>
                  <span class="photo-badge">Primary Exterior</span>
                </div>
              </div>

              <!-- SUPPORTING 4-IMAGE GRID -->
              <div class="supporting-photos-grid">
                {threeBedroom.gallery.slice(1).map((photo) => (
                  <div class="supporting-photo-card">
                    <div class="photo-contain-box sm-box">
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        width="800"
                        height="530"
                        loading="lazy"
                        decoding="async"
                        class="photo-img-contain"
                      />
                      <div class="photo-ambient-bg" style={`background-image: url('${photo.src}')`} aria-hidden="true"></div>
                    </div>
                    <div class="photo-caption-bar sm-caption">
                      <span class="photo-caption-text">{photo.caption}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- BOTTOM SECTION BAR & CTA -->
          <div class="boat-foot-action">
            <div class="price-callout">
              <span class="price-from">Starting Rate</span>
              <span class="price-val">{threeBedroom.startingRate}</span>
              <span class="price-note">{threeBedroom.rateLabel}</span>
            </div>

            <div class="foot-btns">
              <a href={`#book-houseboat?type=${threeBedroom.id}`} class="btn btn-primary">
                Book 3-Bedroom Cruise
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="#dining-experience" class="btn btn-outline-white">
                View Food Menu
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ===================================================
         03 — SIX BEDROOM HOUSEBOAT (SECTION 2)
    =================================================== -->
    {sixBedroom && (
      <section id="six-bedroom" class="houseboat-section section-forest-light" aria-labelledby="heading-6bed">
        <div class="container">
          <div class="boat-section-head">
            <div class="section-tag-group">
              <span class="badge-accent">GROUP & REUNION SANCTUARY</span>
              <span class="badge-sub">{sixBedroom.categoryBadge}</span>
            </div>

            <div class="boat-title-wrap">
              <h2 id="heading-6bed" class="boat-main-title">
                {sixBedroom.category}
              </h2>
              <span class="boat-capacity-tag">Capacity: {sixBedroom.capacity}</span>
            </div>

            <p class="boat-tagline">{sixBedroom.tagline}</p>
            <p class="boat-overview">{sixBedroom.overview}</p>

            <div class="specs-grid">
              {sixBedroom.specifications.map((spec) => (
                <div class="spec-card">
                  <span class="spec-label">{spec.label}</span>
                  <span class="spec-val">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- PREMIUM VISUAL GALLERY COMPOSITION -->
          {sixBedroom.gallery && sixBedroom.gallery.length > 0 && (
            <div class="boat-gallery-wrapper">
              <div class="gallery-lead">
                <h3 class="gallery-heading">Verified Photo Showcase</h3>
                <p class="gallery-sub">Authentic dining hall, deluxe staterooms, and modern en-suite photos from our active Six Bedroom backwater fleet.</p>
              </div>

              <div class="six-bed-visual-layout">
                <!-- FEATURED LARGE IMAGE -->
                <div class="featured-photo-card">
                  <div class="photo-contain-box">
                    <img
                      src={sixBedroom.gallery[0].src}
                      alt={sixBedroom.gallery[0].alt}
                      width="1200"
                      height="728"
                      loading="lazy"
                      decoding="async"
                      class="photo-img-contain"
                    />
                    <div class="photo-ambient-bg" style={`background-image: url('${sixBedroom.gallery[0].src}')`} aria-hidden="true"></div>
                  </div>
                  <div class="photo-caption-bar">
                    <span class="photo-caption-text">{sixBedroom.gallery[0].caption}</span>
                    <span class="photo-badge">Grand Dining Hall</span>
                  </div>
                </div>

                <!-- SUPPORTING 3-IMAGE GRID -->
                <div class="supporting-photos-grid">
                  {sixBedroom.gallery.slice(1).map((photo, idx) => (
                    <div class={`supporting-photo-card ${idx === 2 ? 'span-two' : ''}`}>
                      <div class="photo-contain-box sm-box">
                        <img
                          src={photo.src}
                          alt={photo.alt}
                          width="800"
                          height="530"
                          loading="lazy"
                          decoding="async"
                          class="photo-img-contain"
                        />
                        <div class="photo-ambient-bg" style={`background-image: url('${photo.src}')`} aria-hidden="true"></div>
                      </div>
                      <div class="photo-caption-bar sm-caption">
                        <span class="photo-caption-text">{photo.caption}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          <!-- KEY HIGHLIGHTS CHIPS -->
          <div class="key-highlights-chips" style="margin-top: 24px; margin-bottom: 24px;">
            {sixBedroom.features.map((f) => (
              <span class="feature-chip">✦ {f}</span>
            ))}
          </div>

          <!-- BOTTOM SECTION BAR & CTA -->
          <div class="boat-foot-action">
            <div class="price-callout">
              <span class="price-from">Starting Rate</span>
              <span class="price-val">{sixBedroom.startingRate}</span>
              <span class="price-note">{sixBedroom.rateLabel}</span>
            </div>

            <div class="foot-btns">
              <a href={`#book-houseboat?type=${sixBedroom.id}`} class="btn btn-primary">
                Book 6-Bedroom Cruise
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="#dining-experience" class="btn btn-outline-white">
                View Food Menu
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ===================================================
         04 — TEN BEDROOM HOUSEBOAT (SECTION 3)
    =================================================== -->
    {tenBedroom && (
      <section id="ten-bedroom" class="houseboat-section section-forest-dark" aria-labelledby="heading-10bed">
        <div class="container">
          <div class="boat-section-head">
            <div class="section-tag-group">
              <span class="badge-accent">MEGA BACKWATER CRUISER</span>
              <span class="badge-sub">{tenBedroom.categoryBadge}</span>
            </div>

            <div class="boat-title-wrap">
              <h2 id="heading-10bed" class="boat-main-title">
                {tenBedroom.category}
              </h2>
              <span class="boat-capacity-tag">Capacity: {tenBedroom.capacity}</span>
            </div>

            <p class="boat-tagline">{tenBedroom.tagline}</p>
            <p class="boat-overview">{tenBedroom.overview}</p>

            <div class="specs-grid">
              {tenBedroom.specifications.map((spec) => (
                <div class="spec-card">
                  <span class="spec-label">{spec.label}</span>
                  <span class="spec-val">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- PREMIUM VISUAL GALLERY COMPOSITION -->
          {tenBedroom.gallery && tenBedroom.gallery.length > 0 && (
            <div class="boat-gallery-wrapper">
              <div class="gallery-lead">
                <div class="gallery-lead-row">
                  <div>
                    <h3 class="gallery-heading">Verified Photo Showcase</h3>
                    <p class="gallery-sub">Authentic double-decker banquet hall, stateroom suites, luxury living lounge, and en-suite facilities.</p>
                  </div>
                  <span class="source-tag">Samudra Royal Premium Fleet</span>
                </div>
              </div>

              <div class="ten-bed-visual-layout">
                <!-- FEATURED LARGE IMAGE -->
                <div class="featured-photo-card">
                  <div class="photo-contain-box">
                    <img
                      src={tenBedroom.gallery[0].src}
                      alt={tenBedroom.gallery[0].alt}
                      width="1200"
                      height="728"
                      loading="lazy"
                      decoding="async"
                      class="photo-img-contain"
                    />
                    <div class="photo-ambient-bg" style={`background-image: url('${tenBedroom.gallery[0].src}')`} aria-hidden="true"></div>
                  </div>
                  <div class="photo-caption-bar">
                    <span class="photo-caption-text">{tenBedroom.gallery[0].caption}</span>
                    <span class="photo-badge">Royal Flagship</span>
                  </div>
                </div>

                <!-- SUPPORTING 2 PROMINENT CARDS -->
                <div class="supporting-photos-grid prominent-two">
                  {tenBedroom.gallery.slice(1, 3).map((photo) => (
                    <div class="supporting-photo-card">
                      <div class="photo-contain-box md-box">
                        <img
                          src={photo.src}
                          alt={photo.alt}
                          width="800"
                          height="530"
                          loading="lazy"
                          decoding="async"
                          class="photo-img-contain"
                        />
                        <div class="photo-ambient-bg" style={`background-image: url('${photo.src}')`} aria-hidden="true"></div>
                      </div>
                      <div class="photo-caption-bar sm-caption">
                        <span class="photo-caption-text">{photo.caption}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- EXTENDED PHOTO SUITE (STATEROOMS & AMENITIES) -->
              <div class="ten-bed-extended-grid">
                {tenBedroom.gallery.slice(3).map((photo) => (
                  <div class="supporting-photo-card">
                    <div class="photo-contain-box sm-box">
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        width="800"
                        height="530"
                        loading="lazy"
                        decoding="async"
                        class="photo-img-contain"
                      />
                      <div class="photo-ambient-bg" style={`background-image: url('${photo.src}')`} aria-hidden="true"></div>
                    </div>
                    <div class="photo-caption-bar sm-caption">
                      <span class="photo-caption-text">{photo.caption}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- KEY HIGHLIGHTS CHIPS -->
          <div class="key-highlights-chips" style="margin-top: 24px; margin-bottom: 24px;">
            {tenBedroom.features.map((f) => (
              <span class="feature-chip">✦ {f}</span>
            ))}
          </div>

          <!-- BOTTOM SECTION BAR & CTA -->
          <div class="boat-foot-action">
            <div class="price-callout">
              <span class="price-from">Starting Rate</span>
              <span class="price-val">{tenBedroom.startingRate}</span>
              <span class="price-note">{tenBedroom.rateLabel}</span>
            </div>

            <div class="foot-btns">
              <a href={`#book-houseboat?type=${tenBedroom.id}`} class="btn btn-primary">
                Book 10-Bedroom Grand Cruise
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="#dining-experience" class="btn btn-outline-white">
                View Food Menu
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ===================================================
         05 — AUTHENTIC DINING & DAILY SCHEDULE
    =================================================== -->
    <section id="dining-experience" class="houseboat-section dining-section">
      <div class="container">
        <div class="section-head section-head-center">
          <div class="section-eyebrow">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>GASTRONOMY ON THE WATERWAYS</span>
            <span class="eyebrow-line" aria-hidden="true"></span>
          </div>
          <h2 class="section-title">
            Traditional <span class="editorial-accent">Kerala Culinary Journey</span>
          </h2>
          <p class="section-lede">
            Every houseboat comes with your private dedicated onboard chef who prepares fresh authentic delicacies live on deck as you sail.
          </p>
        </div>

        <div class="dining-composition">
          <!-- MEAL TIMINGS TIMELINE -->
          <div class="dining-menu-list">
            {authenticDiningMenu.courses.map((course, idx) => (
              <div class="menu-course-card">
                <div class="course-meta">
                  <span class="course-step">0{idx + 1}</span>
                  <span class="course-timing">⏰ {course.timing}</span>
                </div>
                <h3 class="course-name">{course.name}</h3>
                <p class="course-items">{course.items}</p>
              </div>
            ))}
          </div>

          <!-- ITINERARY SIDEBAR -->
          <div class="schedule-sidebar">
            <div class="schedule-head">
              <span class="schedule-icon">⚓</span>
              <div>
                <h3 class="schedule-title">Standard Cruise Itinerary</h3>
                <span class="schedule-subtitle">Overnight Backwater Experience</span>
              </div>
            </div>

            <div class="timeline-items">
              {cruiseSchedule.map((item) => (
                <div class="timeline-point">
                  <span class="point-time">{item.time}</span>
                  <div class="point-body">
                    <strong>{item.title}</strong>
                    <p>{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="schedule-note">
              <span class="note-icon">ℹ️</span>
              <p>Houseboats anchor by 5:30 PM per Kerala Port Authority safety laws. A/C operates throughout the night from 9:00 PM to 6:00 AM (Deluxe) or 24 Hours (Premium).</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================
         06 — BOOKING & CUSTOM INQUIRY
    =================================================== -->
    <section id="book-houseboat" class="houseboat-section booking-section">
      <div class="container">
        <div class="booking-card">
          <div class="booking-left">
            <div class="booking-badge">
              <span>✦ PERSONALIZED RESERVATIONS</span>
            </div>
            <h2 class="booking-title">Reserve Your Private Backwater Cruise</h2>
            <p class="booking-desc">
              Tell us your preferred dates and guest count. Our backwater travel specialists in Alleppey will coordinate the ideal boat category, tailored menu, and secure jetty transfers.
            </p>

            <ul class="booking-perks">
              <li>✓ Verified private Kettuvallam with licensed crew</li>
              <li>✓ All meals (Lunch, Tea, Dinner, Breakfast) included</li>
              <li>✓ Transparent pricing with zero hidden docking fees</li>
              <li>✓ Customizable cruise routes in Alleppey & Kumarakom</li>
            </ul>

            <div class="direct-contact-row">
              <a href="tel:+919495117755" class="phone-link">
                <span>📞 Call Specialist: +91 9495 117 755</span>
              </a>
            </div>
          </div>

          <div class="booking-right">
            <form class="booking-form" onsubmit="event.preventDefault(); alert('Thank you! Our houseboat specialist will contact you shortly.');">
              <div class="form-group">
                <label for="boat-type">Select Houseboat Size</label>
                <select id="boat-type" name="boatType" class="form-input">
                  <option value="three-bedroom">Three Bedroom Houseboat (6–9 Guests)</option>
                  <option value="six-bedroom">Six Bedroom Houseboat (12–18 Guests)</option>
                  <option value="ten-bedroom">Ten Bedroom Houseboat (20–30 Guests)</option>
                  <option value="custom">Not sure / Advise based on group</option>
                </select>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="travel-date">Preferred Travel Date</label>
                  <input type="date" id="travel-date" name="travelDate" class="form-input" required />
                </div>
                <div class="form-group">
                  <label for="guest-count">Number of Guests</label>
                  <input type="number" id="guest-count" name="guestCount" placeholder="e.g. 6" min="1" max="50" class="form-input" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="guest-name">Your Full Name</label>
                  <input type="text" id="guest-name" name="name" placeholder="John Doe" class="form-input" required />
                </div>
                <div class="form-group">
                  <label for="guest-phone">Phone / WhatsApp</label>
                  <input type="tel" id="guest-phone" name="phone" placeholder="+91 98765 43210" class="form-input" required />
                </div>
              </div>

              <div class="form-group">
                <label for="special-requests">Dietary Preferences or Special Requests</label>
                <textarea id="special-requests" name="notes" rows="3" placeholder="e.g. Vegetarian feast, Karimeen fry, cake for anniversary..." class="form-input"></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-block">
                Request Houseboat Availability
                <span class="btn-arrow" aria-hidden="true">→</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===================================================
     GLOBAL HOUSEBOATS STYLING
  =================================================== */
  .houseboats-page {
    background-color: var(--color-bg, #061913);
    color: #ffffff;
    font-family: var(--font-body, 'Poppins', sans-serif);
  }

  /* 01 — HERO */
  .houseboat-hero-section {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: clamp(100px, 14vw, 160px) 0 clamp(60px, 8vw, 100px);
    overflow: hidden;
  }

  .houseboat-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
