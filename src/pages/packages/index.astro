---
// src/pages/packages/index.astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { packages } from "../../data/packages.js";
import "../../styles/global.css";

const packagesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Kerala Tour Packages",
  "description": "Curated Kerala tour packages featuring backwater houseboats, hill stations, wildlife sanctuaries, and romantic escapes.",
  "itemListElement": packages.map((pkg, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": pkg.title,
    "url": `https://makemykerala.vercel.app${pkg.itineraryLink}`
  }))
};
---

<Layout
  title="Kerala Tour Packages | Curated South India Holidays - Make My Kerala"
  description="Explore our curated Kerala tour packages covering Munnar, Thekkady, Alappuzha, Kumarakom and Kovalam. Verified stays, seamless transfers, and 25 years of travel excellence."
  schema={packagesSchema}
>
  <Header />

  <main class="packages-page">
    
    <!-- 1. EDITORIAL HERO BANNER -->
    <section class="packages-hero" aria-label="Kerala Packages Hero">
      <div class="packages-hero-bg" aria-hidden="true">
        <img
          src="/images/allapey.webp"
          alt="Tranquil Kerala backwaters and houseboats"
          width="1920"
          height="700"
          class="packages-hero-img"
          loading="eager"
          decoding="async"
        />
        <div class="packages-hero-veil"></div>
      </div>

      <div class="container packages-hero-inner">

        <div class="section-eyebrow hero-eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span>CURATED SOUTH INDIA EXPERIENCES</span>
          <span class="eyebrow-line" aria-hidden="true"></span>
        </div>

        <h1 class="packages-hero-title">
          Kerala <span class="editorial-accent">Tour Packages</span>
        </h1>

        <p class="packages-hero-desc">
          Thoughtfully crafted journeys across Kerala, shaped by 25 years of local expertise.
        </p>
      </div>
    </section>

    <!-- 2. PACKAGES DIRECTORY -->
    <section class="section section-sand packages-list-section" aria-label="Curated Itineraries">
      <div class="container">
        
        <!-- SECTION HEAD -->
        <div class="section-head section-head-center">
          <div class="section-eyebrow">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>HANDPICKED FOR YOU</span>
            <span class="eyebrow-line" aria-hidden="true"></span>
          </div>
          <h2 class="section-title">
            Signature <span class="editorial-accent">Itineraries</span>
          </h2>
          <p class="section-lede">
            Every itinerary includes private sanitised transfers, handpicked boutique stays, curated breakfast, and 24/7 dedicated on-tour assistance.
          </p>
        </div>

        <!-- PACKAGES GRID -->
        <div class="packages-directory-grid">
          {packages.map((pkg, idx) => (
            <article class={`pkg-card reveal ${idx === 1 ? 'reveal-delay-1' : idx === 2 ? 'reveal-delay-2' : idx === 3 ? 'reveal-delay-3' : ''}`}>
              <!-- CARD MEDIA -->
              <a href={pkg.itineraryLink} class="pkg-media-wrap" aria-label={`View ${pkg.title} itinerary`}>
                <img
                  src={pkg.image}
                  alt={pkg.title}
                  width="600"
                  height="338"
                  loading="lazy"
                  decoding="async"
                  class="pkg-img"
                />
                <div class="pkg-media-veil"></div>
                <span class="pkg-duration-pill">{pkg.duration}</span>
              </a>

              <!-- CARD CONTENT -->
              <div class="pkg-content">
                <div class="pkg-route">
                  <span class="route-pin" aria-hidden="true">📍</span>
                  <span class="route-names">{pkg.places}</span>
                </div>

                <h3 class="pkg-title">
                  <a href={pkg.itineraryLink}>{pkg.title}</a>
                </h3>

                <p class="pkg-desc">{pkg.description}</p>

                <!-- HIGHLIGHT BULLETS -->
                {pkg.highlights && (
                  <ul class="pkg-highlights-list">
                    {pkg.highlights.slice(0, 3).map((h) => (
                      <li class="pkg-highlight-item">
                        <span class="highlight-check" aria-hidden="true">✓</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <!-- FOOTER -->
                <div class="pkg-footer">
                  <a href={pkg.itineraryLink} class="btn btn-primary btn-sm">
                    View Itinerary
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- 3. BESPOKE TRIP PLANNING CTA BANNER -->
        <div class="custom-plan-banner reveal">
          <div class="custom-plan-content">
            <span class="custom-eyebrow">BESPOKE TRAVEL PLANNING</span>
            <h3 class="custom-title">Looking for a Tailor-Made Itinerary?</h3>
            <p class="custom-desc">
              Every package can be 100% customized to your preferred travel dates, hotel choices, and sightseeing pace. Speak with our local travel specialists in Kochi today.
            </p>
            <div class="custom-actions">
              <a
                href="https://wa.me/919745269272?text=Hello%20MakeMyKerala%2C%20I%20would%20like%20to%20plan%20a%20customized%20Kerala%20holiday"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-wa"
              >
                Chat on WhatsApp
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a href="/enquiry/" class="btn btn-outline-forest">
                Send Trip Enquiry
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <div class="custom-badge-col">
            <div class="experience-circle">
              <strong class="exp-num">25+</strong>
              <span class="exp-text">Years Local Mastery</span>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .packages-page {
    background-color: var(--color-sand-light, #fbf8f2);
  }

  /* ===================================================
     1. HERO BANNER
  =================================================== */
  .packages-hero {
    position: relative;
    width: 100%;
    min-height: clamp(380px, 42vh, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: clamp(65px, 8vw, 90px);
    overflow: hidden;
  }

  .packages-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .packages-hero-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 65%;
  }

  .packages-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 32, 23, 0.65) 0%,
      rgba(8, 32, 23, 0.82) 100%
    );
  }

  .packages-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-gold-light, #e5a95b) !important;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
    justify-content: center;
  }

  .hero-eyebrow .eyebrow-line {
    background-color: rgba(200, 139, 59, 0.5) !important;
  }

  .packages-hero-title {
    font-family: var(--font-serif, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 14px;
    text-wrap: balance;
  }

  .packages-hero-desc {
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 auto;
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* ===================================================
     2. PACKAGES DIRECTORY GRID
  =================================================== */
  .packages-list-section {
    padding-top: 60px;
    padding-bottom: 90px;
  }

  .packages-directory-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    align-items: stretch;
    margin-bottom: 60px;
  }

  .pkg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle, rgba(18, 56, 42, 0.08));
    box-shadow: var(--shadow-sm, 0 4px 12px rgba(18, 56, 42, 0.05));
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .pkg-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg, 0 18px 45px rgba(18, 56, 42, 0.12));
  }

  .pkg-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: block;
    background-color: #e8e2d8;
    flex-shrink: 0;
  }

  .pkg-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 72%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pkg-card:hover .pkg-img {
    transform: scale(1.05);
  }

  .pkg-media-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 50%,
      rgba(8, 32, 23, 0.32) 100%
    );
    pointer-events: none;
  }

  .pkg-duration-pill {
    position: absolute;
    bottom: 14px;
    left: 14px;
    padding: 6px 14px;
    border-radius: 20px;
    background: rgba(8, 32, 23, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .pkg-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 26px 24px 24px;
  }

  .pkg-route {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .route-pin {
    font-size: 0.84rem;
    flex-shrink: 0;
  }

  .route-names {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-gold, #c88b3b);
  }

  .pkg-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-forest, #12382a);
    line-height: 1.25;
    margin-bottom: 10px;
  }

  .pkg-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pkg-title a:hover {
    color: var(--color-gold, #c88b3b);
  }

  .pkg-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted, #5a6b63);
    margin-bottom: 18px;
    flex: 1;
  }

  /* HIGHLIGHTS LIST */
  .pkg-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0 0 22px;
    padding: 14px 16px;
    background-color: var(--color-sand-light, #fbf8f2);
    border-radius: 12px;
    border: 1px solid var(--color-border-subtle, rgba(18, 56, 42, 0.07));
    list-style: none;
  }

  .pkg-highlight-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-forest, #12382a);
  }

  .highlight-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: rgba(200, 139, 59, 0.15);
    color: var(--color-gold, #c88b3b);
    font-size: 0.72rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* FOOTER */
  .pkg-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-border-subtle, rgba(18, 56, 42, 0.08));
  }

  .pkg-price-col {
    display: flex;
    flex-direction: column;
    min-width: fit-content;
  }

  .price-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-subtle, #7a8c83);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .price-amount {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-forest, #12382a);
    line-height: 1.1;
  }

  .price-note {
    font-size: 0.72rem;
    color: var(--color-text-subtle, #7a8c83);
  }

  .pkg-footer .btn {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ===================================================
     3. BESPOKE PLANNING BANNER
  =================================================== */
  .custom-plan-banner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
    background: linear-gradient(135deg, #ffffff 0%, var(--color-sand-light, #fbf8f2) 100%);
    border-radius: 24px;
    padding: 44px 48px;
    border: 1px solid var(--color-border-subtle, rgba(18, 56, 42, 0.1));
    box-shadow: var(--shadow-md, 0 10px 28px rgba(18, 56, 42, 0.07));
  }

  .custom-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold, #c88b3b);
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .custom-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    color: var(--color-forest, #12382a);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .custom-desc {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-muted, #5a6b63);
    max-width: 680px;
    margin-bottom: 24px;
  }

  .custom-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn-wa {
    background-color: #25d366;
    color: #ffffff;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .btn-wa:hover {
    background-color: #20bd5a;
    transform: translateY(-2px);
    color: #ffffff;
  }

  .experience-circle {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background-color: var(--color-forest, #12382a);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
    padding: 16px;
    box-shadow: 0 8px 24px rgba(18, 56, 42, 0.2);
  }

  .exp-num {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--color-gold-light, #e5a95b);
    line-height: 1;
    margin-bottom: 4px;
  }

  .exp-text {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
  }

  /* ===================================================
     RESPONSIVE BREAKPOINTS
  =================================================== */
  @media (max-width: 1024px) {
    .packages-directory-grid {
      gap: 24px;
    }

    .custom-plan-banner {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 32px 28px;
    }

    .custom-badge-col {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .packages-directory-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .packages-hero {
      min-height: 350px;
      padding-block: 55px;
    }

    .pkg-content {
      padding: 22px 20px 20px;
    }

    .pkg-title {
      font-size: 1.35rem;
    }

    .custom-actions {
      flex-direction: column;
    }

    .custom-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 440px) {
    .pkg-content {
      padding: 18px 16px 16px;
    }

    .pkg-title {
      font-size: 1.25rem;
    }

    .pkg-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .pkg-footer .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>