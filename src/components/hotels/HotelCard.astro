---
// src/components/hotels/HotelCard.astro
interface Props {
  hotel: {
    slug: string;
    name: string;
    tagline: string;
    category: string;
    starRating: number;
    userRating: number;
    reviewsCount: number;
    startingPrice: string;
    priceLabel: string;
    locality: string;
    heroImage: string;
    heroImageSm?: string;
    highlights: string[];
    destination?: string;
    destinationName?: string;
  };
}

const { hotel } = Astro.props;
const destination = hotel.destination || "kochi";
const destinationName = hotel.destinationName || (destination === "munnar" ? "Munnar" : "Kochi");
const detailUrl = (hotel as any).detailUrl
  ? (hotel as any).detailUrl
  : (hotel as any).state === "tamil-nadu"
    ? `/hotels/tamil-nadu/${destination}/${hotel.slug}/`
    : `/hotels/${destination}/${hotel.slug}/`;
---

<article class="hotel-card" id={`hotel-${hotel.slug}`}>
  <!-- IMAGE & OVERLAYS -->
  <div class="hotel-media">
    <a href={detailUrl} class="hotel-media-link" aria-label={`View details for ${hotel.name}`}>
      <img
        src={hotel.heroImageSm || hotel.heroImage}
        srcset={`${hotel.heroImageSm || hotel.heroImage} 640w, ${hotel.heroImage} 1280w`}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
        alt={`${hotel.name} exterior facade in ${destinationName}`}
        width="640"
        height="420"
        loading="lazy"
        decoding="async"
        class="hotel-card-img"
      />
    </a>

    <!-- BADGES -->
    <div class="hotel-media-tags">
      <span class="hotel-category-badge">{hotel.category}</span>
      <span class="hotel-rating-badge">
        <span class="star-icon" aria-hidden="true">★</span>
        <span class="rating-val">{hotel.userRating}</span>
        <span class="rating-count">({hotel.reviewsCount})</span>
      </span>
    </div>
  </div>

  <!-- BODY CONTENT -->
  <div class="hotel-body">
    <div class="hotel-meta-row">
      <span class="hotel-locality">
        <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s7-6.2 7-12A7 7 0 0 0 5 9c0 5.8 7 12 7 12Z"/>
          <circle cx="12" cy="9" r="2.5"/>
        </svg>
        {hotel.locality}, {destinationName}
      </span>
      <span class="hotel-stars">
        {Array.from({ length: hotel.starRating }).map(() => (
          <span class="star-glyph">★</span>
        ))}
      </span>
    </div>

    <h3 class="hotel-title">
      <a href={detailUrl}>{hotel.name}</a>
    </h3>

    <p class="hotel-tagline">{hotel.tagline}</p>

    <!-- KEY HIGHLIGHTS -->
    <div class="hotel-highlights-list">
      {((hotel as any).highlights || (hotel as any).specialties || []).slice(0, 3).map((item: string) => (
        <span class="hotel-pill">
          <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          {item}
        </span>
      ))}
    </div>

    <!-- FOOTER / CTA -->
    <div class="hotel-card-foot">
      <a href={detailUrl} class="hotel-view-btn">
        <span>{(hotel as any).btnText || "View Details"}</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .hotel-card {
    background-color: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle, rgba(13, 46, 35, 0.08));
    box-shadow: var(--shadow-sm, 0 4px 14px rgba(6, 25, 19, 0.05));
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    position: relative;
  }

  .hotel-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(6, 25, 19, 0.12);
    border-color: rgba(200, 139, 59, 0.35);
  }

  /* MEDIA */
  .hotel-media {
    position: relative;
    aspect-ratio: 16 / 10.5;
    overflow: hidden;
    background-color: #0e241c;
    display: block;
    width: 100%;
  }

  .hotel-media-link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hotel-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hotel-card:hover .hotel-card-img {
    transform: scale(1.03);
  }

  .hotel-media-tags {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .hotel-category-badge {
    background-color: rgba(13, 46, 35, 0.88);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: var(--font-eyebrow, "Poppins", sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .hotel-rating-badge {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    color: var(--color-forest, #0d2e23);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .hotel-rating-badge .star-icon {
    color: #e59819;
    font-size: 0.85rem;
  }

  .hotel-rating-badge .rating-count {
    color: var(--color-muted, #53645b);
    font-size: 0.7rem;
    font-weight: 500;
  }



  /* BODY */
  .hotel-body {
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 12px;
  }

  .hotel-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hotel-locality {
    font-family: var(--font-eyebrow, "Poppins", sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-gold, #c88b3b);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .meta-icon {
    width: 14px;
    height: 14px;
    stroke: currentColor;
  }

  .hotel-stars {
    color: #e59819;
    font-size: 0.85rem;
    letter-spacing: 2px;
  }

  .hotel-title {
    font-family: var(--font-display, "Poppins", sans-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-forest, #0d2e23);
    margin: 0;
  }

  .hotel-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hotel-title a:hover {
    color: var(--color-gold, #c88b3b);
  }

  .hotel-tagline {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-muted, #53645b);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .hotel-highlights-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 4px;
  }

  .hotel-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8rem;
    color: var(--color-text, #1b2821);
    background-color: var(--color-ivory, #f7f3ea);
    padding: 4px 10px;
    border-radius: 6px;
    line-height: 1.3;
  }

  .check-icon {
    width: 14px;
    height: 14px;
    color: #0e7a4b;
    flex-shrink: 0;
  }

  /* FOOTER */
  .hotel-card-foot {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle, rgba(13, 46, 35, 0.08));
    display: flex;
    width: 100%;
  }

  .hotel-view-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--color-forest, #0d2e23);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hotel-view-btn:hover {
    background-color: var(--color-gold, #c88b3b);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(200, 139, 59, 0.25);
  }

  .btn-arrow {
    transition: transform 0.25s ease;
  }

  .hotel-view-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .hotel-media-tags {
      top: 10px;
      left: 10px;
      right: 10px;
      flex-wrap: wrap;
      gap: 6px;
    }

    .hotel-category-badge {
      font-size: 0.68rem;
      padding: 4px 10px;
    }

    .hotel-rating-badge {
      font-size: 0.72rem;
      padding: 3px 8px;
    }

    .hotel-body {
      padding: 16px;
      gap: 10px;
    }

    .hotel-title {
      font-size: 1.15rem;
      word-break: break-word;
    }

    .hotel-tagline {
      font-size: 0.84rem;
    }

    .hotel-pill {
      font-size: 0.76rem;
      padding: 3px 8px;
    }

    .hotel-card-foot {
      padding-top: 12px;
    }

    .hotel-view-btn {
      font-size: 0.82rem;
      padding: 10px 16px;
    }
  }
</style>
