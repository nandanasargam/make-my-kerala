---
// src/components/hotels/HotelFacilities.astro
interface Facility {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  hotelName: string;
  facilities: (Facility | string)[];
}

const { hotelName, facilities = [] } = Astro.props;

const normalizedFacilities: Facility[] = (facilities || []).map((fac) => {
  if (typeof fac === "string") {
    let icon = "concierge";
    const lower = fac.toLowerCase();
    if (lower.includes("wifi") || lower.includes("wi-fi") || lower.includes("internet")) icon = "wifi";
    else if (lower.includes("pool") || lower.includes("swimming")) icon = "pool";
    else if (lower.includes("dine") || lower.includes("restaurant") || lower.includes("café") || lower.includes("food")) icon = "dining";
    else if (lower.includes("spa") || lower.includes("ayur") || lower.includes("wellness")) icon = "spa";
    else if (lower.includes("meet") || lower.includes("conference") || lower.includes("banquet") || lower.includes("boardroom")) icon = "meetings";
    else if (lower.includes("gym") || lower.includes("fitness")) icon = "gym";
    else if (lower.includes("park") || lower.includes("valet")) icon = "parking";
    return {
      icon,
      title: fac,
      description: `Verified guest amenity curated for comfort, productivity, and relaxation at ${hotelName}.`
    };
  }
  return fac;
});
---

<section class="section hotel-facilities-section reveal" id="facilities" aria-label="Facilities and Amenities">
  <div class="container">
    <div class="section-head section-head-center">
      <div class="section-eyebrow">
        <span class="eyebrow-dash" aria-hidden="true">—</span>
        <span>EXPERIENCE & CONVENIENCES</span>
      </div>
      <h2 class="section-title">
        Facilities & Amenities at <span class="editorial-accent">{hotelName}</span>
      </h2>
      <p class="section-lede">
        Curated infrastructure ensuring effortless rest, productive business engagements, and rejuvenating leisure.
      </p>
    </div>

    <div class="facilities-grid">
      {normalizedFacilities.map((fac) => (
        <div class="facility-card">
          <div class="facility-icon-wrap">
            {fac.icon === "wifi" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/>
              </svg>
            )}
            {fac.icon === "pool" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
              </svg>
            )}
            {fac.icon === "dining" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/>
              </svg>
            )}
            {fac.icon === "spa" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            )}
            {fac.icon === "meetings" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            )}
            {fac.icon === "gym" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 5v14M18 5v14M2 9v6M22 9v6M6 12h12"/>
              </svg>
            )}
            {fac.icon === "parking" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>
              </svg>
            )}
            {fac.icon === "track" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            )}
            {fac.icon === "railway" && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="3" width="16" height="16" rx="2"/>
                <path d="M4 11h16M12 3v8M8 19l-3 3M16 19l3 3M8 15h.01M16 15h.01"/>
              </svg>
            )}
            {!["wifi", "pool", "dining", "spa", "meetings", "gym", "parking", "track", "railway"].includes(fac.icon) && (
              <svg viewBox="0 0 24 24" class="fac-svg" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            )}
          </div>

          <div class="facility-content">
            <h3 class="facility-name">{fac.title}</h3>
            <p class="facility-desc">{fac.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hotel-facilities-section {
    background-color: var(--color-sand-light, #fbf8f2);
    padding-block: clamp(70px, 9vw, 110px);
  }

  .eyebrow-dash {
    color: var(--color-gold, #c88b3b);
    font-weight: 800;
  }

  .editorial-accent {
    font-style: italic;
    color: var(--color-forest, #0d2e23);
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 992px) {
    .facilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .facilities-grid {
      grid-template-columns: 1fr;
    }
  }

  .facility-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border, #e0d8cb);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .facility-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
    border-color: rgba(200, 139, 59, 0.4);
  }

  .facility-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: var(--color-ivory, #f7f3ea);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-forest, #0d2e23);
    border: 1px solid rgba(13, 46, 35, 0.08);
  }

  .fac-svg {
    width: 24px;
    height: 24px;
  }

  .facility-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .facility-name {
    font-family: var(--font-eyebrow, "Space Grotesk", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-forest, #0d2e23);
    margin: 0;
  }

  .facility-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-muted, #53645b);
    margin: 0;
  }
</style>
