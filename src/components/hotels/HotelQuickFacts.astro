---
// src/components/hotels/HotelQuickFacts.astro
interface Props {
  quickFacts: Array<{
    label: string;
    value: string;
  }>;
}

const { quickFacts } = Astro.props;
---

<section class="quick-facts-section reveal-up" aria-label="Key Hotel Facts">
  <div class="container">
    <div class="facts-card">
      <div class="facts-grid">
        {quickFacts.map((fact, index) => (
          <div class="fact-item">
            <span class="fact-label">{fact.label}</span>
            <span class="fact-value">{fact.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .quick-facts-section {
    padding-top: 0;
    padding-bottom: clamp(30px, 4vw, 50px);
    margin-top: -24px;
    position: relative;
    z-index: 5;
  }

  .facts-card {
    background-color: #ffffff;
    border-radius: 18px;
    border: 1px solid var(--color-border, #e0d8cb);
    box-shadow: 0 8px 24px rgba(6, 25, 19, 0.06);
    padding: 24px 32px;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .facts-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .facts-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .facts-card {
      padding: 20px;
    }
  }

  @media (max-width: 360px) {
    .facts-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .facts-card {
      padding: 16px 14px;
    }
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
  }

  .fact-item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -10px;
    top: 15%;
    height: 70%;
    width: 1px;
    background-color: var(--color-border-subtle, rgba(13, 46, 35, 0.08));
  }

  @media (max-width: 1024px) {
    .fact-item:not(:last-child)::after {
      display: none;
    }
  }

  .fact-label {
    font-family: var(--font-eyebrow, "Poppins", sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted, #53645b);
  }

  .fact-value {
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--color-forest, #0d2e23);
    line-height: 1.3;
  }
</style>
