<!-- SPACER TO PREVENT CONTENT OVERLAP WITH FIXED HEADER -->
<div class="header-spacer" aria-hidden="true"></div>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const updateHeader = () => {
      if (window.scrollY > 24) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();

    // Hotels Mega-Menu Tab Switcher (Hover & Click)
    const stateBtns = document.querySelectorAll('.state-nav-btn');
    const panels = document.querySelectorAll('.nav-dest-panel');

    function activateState(state) {
      stateBtns.forEach(btn => {
        const isActive = btn.getAttribute('data-state') === state;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      panels.forEach(panel => {
        const isActive = panel.id === `panel-${state}`;
        panel.classList.toggle('is-active', isActive);
      });
    }

    stateBtns.forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        const state = btn.getAttribute('data-state');
        if (state) activateState(state);
      });
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const state = btn.getAttribute('data-state');
        if (state) activateState(state);
      });
    });
  })();
</script>