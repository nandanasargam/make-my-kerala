---
// src/components/Hero.astro
---

<section class="hero" id="top" aria-label="Welcome to MakeMyKerala">
  <!-- 1. CINEMATIC MEDIA LAYER -->
  <div class="hero-media" id="hero-media-wrap" aria-hidden="true">
    <video
      class="hero-media-element"
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/allapey.webp"
    >
      <source src="/video/keralavideo.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
  </div>

  <!-- 2. HERO CONTENT CONTAINER -->
  <div class="container hero-container">
    <div class="hero-content">
      <!-- EYEBROW -->
      <div class="hero-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>DISCOVER KERALA</span>
      </div>

      <!-- MAIN HEADLINE -->
      <h1 class="hero-title">
        Kerala,<br />
        <span class="editorial-accent">Beyond Ordinary.</span>
      </h1>

      <!-- DESCRIPTION -->
      <p class="hero-description">
        Curated journeys through misty hills, serene backwaters and sun-kissed shores.
      </p>

      <!-- DUAL ACTION CTAS -->
      <div class="hero-actions">
        <a href="/packages" class="btn btn-hero-gold">
          Explore Kerala
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#plan-trip" class="btn btn-hero-glass">
          Plan Your Journey
        </a>
      </div>

      <!-- TRUST STATS RIBBON -->
      <div class="hero-stats">
        <div class="hero-stat-item">
          <strong class="stat-number">500+</strong>
          <span class="stat-label">Happy Travellers</span>
        </div>
        <div class="hero-stat-sep" aria-hidden="true"></div>
        <div class="hero-stat-item">
          <strong class="stat-number">50+</strong>
          <span class="stat-label">Experiences</span>
        </div>
        <div class="hero-stat-sep" aria-hidden="true"></div>
        <div class="hero-stat-item">
          <strong class="stat-number">4.9/5</strong>
          <span class="stat-label">Traveller Rating</span>
        </div>
        <div class="hero-stat-sep" aria-hidden="true"></div>
        <div class="hero-stat-item">
          <strong class="stat-number">25+</strong>
          <span class="stat-label">Years Heritage</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. SCROLL DOWN CUE -->
  <a href="#about" class="hero-scroll-cue" aria-label="Scroll to discover Kerala">
    <span class="scroll-cue-mouse" aria-hidden="true">
      <span class="scroll-cue-dot"></span>
    </span>
    <span class="scroll-cue-text">Scroll to Discover</span>
  </a>
</section>

<!-- SUBTLE HERO PARALLAX / MOVEMENT SCRIPT -->
<script is:inline>
  (() => {
    const heroMedia = document.getElementById('hero-media-wrap');
    if (!heroMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const heroHeight = window.innerHeight;
          if (scrollY <= heroHeight) {
            const progress = scrollY / heroHeight;
            // Subtle slow translateY and scale
            heroMedia.style.transform = `translate3d(0, ${scrollY * 0.28}px, 0) scale(${1 + progress * 0.05})`;
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 720px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #ffffff;
    background-color: var(--color-forest-deep, #082017);
  }

  /* MEDIA LAYER */
  .hero-media {
    position: absolute;
    inset: -5% 0;
    width: 100%;
    height: 110%;
    z-index: 1;
    overflow: hidden;
    will-change: transform;
    pointer-events: none;
  }

  .hero-media-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 32, 23, 0.18) 0%,
      rgba(8, 32, 23, 0.38) 55%,
      rgba(8, 32, 23, 0.76) 100%
    );
    z-index: 2;
  }

  /* CONTENT CONTAINER */
  .hero-container {
    position: relative;
    z-index: 3;
    padding-top: clamp(100px, 15vh, 160px);
    padding-bottom: clamp(90px, 12vh, 130px);
  }

  .hero-content {
    max-width: 820px;
  }

  /* EYEBROW */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-accent, "Manrope", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-light, #e5a95b);
    margin-bottom: 22px;
  }

  .hero-eyebrow .eyebrow-line {
    display: inline-block;
    width: 32px;
    height: 2px;
    background-color: var(--color-gold-light, #e5a95b);
  }

  /* HEADLINE */
  .hero-title {
    font-family: var(--font-display, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(3.2rem, 6vw, 5.2rem);
    font-weight: 700;
    line-height: 1.06;
    color: #ffffff;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }

  .hero-title .editorial-accent {
    color: var(--color-gold-light, #e5a95b);
    font-style: italic;
  }

  /* DESCRIPTION */
  .hero-description {
    font-size: clamp(1.08rem, 1.4vw, 1.28rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 40px;
    max-width: 650px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    text-wrap: pretty;
  }

  /* BUTTONS */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .btn-hero-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 30px;
    border-radius: 30px;
    background-color: var(--color-gold, #c88b3b);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(200, 139, 59, 0.35);
    transition: all 0.3s ease;
  }

  .btn-hero-gold:hover {
    background-color: var(--color-gold-hover, #b0742a);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(200, 139, 59, 0.45);
  }

  .btn-hero-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 30px;
    background: rgba(8, 32, 23, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-hero-glass:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  /* STATS ROW */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .hero-stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-family: var(--font-display, "Cormorant Garamond", Georgia, serif);
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body, "Plus Jakarta Sans", sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-stat-sep {
    width: 1px;
    height: 38px;
    background-color: rgba(255, 255, 255, 0.22);
  }

  /* SCROLL CUE */
  .hero-scroll-cue {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.8);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .hero-scroll-cue:hover {
    color: #ffffff;
    transform: translateX(-50%) translateY(3px);
  }

  .scroll-cue-mouse {
    width: 22px;
    height: 34px;
    border: 1.8px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .scroll-cue-dot {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background-color: var(--color-gold-light, #e5a95b);
    animation: scrollDot 2s infinite ease-in-out;
  }

  @keyframes scrollDot {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    50% {
      opacity: 0.3;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .scroll-cue-text {
    font-family: var(--font-accent, "Manrope", sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero {
      min-height: 620px;
    }

    .hero-title {
      font-size: clamp(2.35rem, 8.5vw, 3rem);
      line-height: 1.1;
      margin-bottom: 18px;
    }

    .hero-description {
      font-size: 1.05rem;
      margin-bottom: 30px;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .hero-stat-sep {
      display: none;
    }

    .hero-actions {
      margin-bottom: 36px;
    }

    .hero-scroll-cue {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .hero-actions .btn,
    .btn-hero-gold,
    .btn-hero-glass {
      width: 100%;
      text-align: center;
    }
  }
</style>
